}

@system(in_state: [GameState::Playing])
fn fly_fireballs(balls: (Entity, Fireball, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (be, b, t) in balls {
        b.vel = b.vel + vec2(0.0, b.gravity * time.dt);
        let step = b.vel * time.dt;
        let len = step.length();
        let hit_wall = false;
        if len > 0.0 {
            hit_wall = physics.raycast_mask(t.position, step * (1.0 / len), len, WALL_BITS).hit;
        }
        if in_wall(physics, t.position) {
            hit_wall = true;
        }
        b.life -= time.dt;
        t.position = t.position + step;
        cmd.insert(b.smoke, Transform { position: t.position, .. });
        cmd.insert(b.sparks, Transform { position: t.position, .. });
        let boom = hit_wall || b.life <= 0.0;
        for (_, _, et) in enemies {
            if t.position.distance(et.position) <= enemy_reach(et) {
                boom = true;
            }
        }
        if boom {
            explode(cmd, t.position, b, enemies);
            cmd.insert(b.smoke, Fx { life: 2.16 });
            cmd.insert(b.sparks, Fx { life: 0.9 });
            cmd.despawn(be);
        }
    }
}

@system(in_state: [GameState::Playing])
fn fly_ice_knives(knives: (Entity, IceKnife, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (ke, k, t) in knives {
        k.vel = k.vel + vec2(0.0, k.gravity * time.dt);
        let step = k.vel * time.dt;
        let len = step.length();
        let hit_wall = false;
        if len > 0.0 {
            hit_wall = physics.raycast_mask(t.position, step * (1.0 / len), len, WALL_BITS).hit;
        }
        if in_wall(physics, t.position) {
            hit_wall = true;
        }
        k.life -= time.dt;
        t.position = t.position + step;
        t.rotation = k.vel.angle();
        cmd.insert(k.sparkle, Transform { position: t.position, .. });
        for (id, e, et) in enemies {
            if t.position.distance(et.position) <= enemy_reach(et) + 14.0 && !k.hit.contains(id.id) {
                k.hit.push(id.id);
                damage_enemy(e, k.damage);
                e.slow_time = k.slow;
                ice_shatter(cmd, et.position, true);
            }
        }
        if hit_wall || k.life <= 0.0 {
            ice_shatter(cmd, t.position, false);
            cmd.insert(k.sparkle, Fx { life: 1.44 });
            cmd.despawn(ke);
        }
    }
}

@system(in_state: [GameState::Playing])
fn gas_clouds(clouds: (Entity, GasCloud, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (ce, c, t) in clouds {
        if !c.landed {
            c.fall += 1400.0 * time.dt;
            let drop = c.fall * time.dt;
            let ground = physics.raycast_mask(t.position, vec2(0.0, 1.0), drop + 40.0, WALL_BITS);
            if ground.hit {
                t.position = vec2(t.position.x, ground.point.y - 40.0);
                c.landed = true;
                flash(cmd, t.position, col(0.4, 1.0, 0.3, 1.0), 2.0, 380.0, 0.2);
            } else {
                t.position = t.position + vec2(0.0, drop);
            }
            cmd.insert(c.bubbles, Transform { position: t.position, .. });
        }
        c.life -= time.dt;
        c.tick -= time.dt;
        if c.tick <= 0.0 {
            c.tick = c.every;
            for (_, e, et) in enemies {
                if t.position.distance(et.position) <= c.radius {
                    damage_enemy(e, c.damage);
                }
            }
        }
        if c.life <= 0.0 {
            cmd.insert(c.bubbles, Fx { life: 0.18 });
            cmd.despawn(ce);
        }
    }
}

@system
fn fade_fx(fx: (Entity, Fx)[], time: Time, cmd: Commands) {
    for (e, f) in fx {
        f.life -= time.dt;
        if f.life <= 0.0 {
            cmd.despawn(e);
        }
    }
}

fn spawn_fire_bolt(cmd: Commands, from: Vec2, dir: Vec2) {
    cmd.spawn([
        at(from.x, from.y),
        FireBolt { vel: dir * 950.0, .. },
        Circle { radius: 8.0, color: col(1.0, 0.92, 0.6, 1.0), z: 155.0, .. },
        PointLight { color: col(1.0, 0.6, 0.2, 1.0), intensity: 1.4, radius: 160.0, falloff: 1.6, shadows: false, .. },
        ParticleEmitter {
            rate: 180.0, lifetime_min: 0.22, lifetime_max: 0.63,
            speed_min: 10.0, speed_max: 70.0,
            size_start: 9.0, size_start_max: 12.0, size_end: 0.5,
            color_start: col(1.0, 0.7, 0.2, 1.0), color_end: col(0.8, 0.1, 0.0, 0.0),
            shape: EmitShape::Circle, shape_radius: 4.0, spin_min: -5.0, spin_max: 5.0,
            blend: Blend::Additive, max_particles: 162, z: 154.0, ..
        },
    ]);
    burst(cmd, from, 16, 200.0, 7.0, col(1.0, 0.9, 0.5, 1.0), col(1.0, 0.3, 0.0, 0.0), 0.25);
}

fn bolt_impact(cmd: Commands, at_pos: Vec2) {
    flash(cmd, at_pos, col(1.0, 0.55, 0.2, 1.0), 3.0, 260.0, 0.1);
    burst(cmd, at_pos, 40, 340.0, 8.0, col(1.0, 0.85, 0.35, 1.0), col(0.8, 0.1, 0.0, 0.0), 0.45);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 24, .. }],
        lifetime_min: 0.54, lifetime_max: 1.26, speed_min: 150.0, speed_max: 520.0, gravity: vec2(0.0, 1300.0),
        size_start: 3.5, size_end: 0.5, color_start: col(1.0, 1.0, 0.7, 1.0), color_end: col(1.0, 0.4, 0.0, 0.0),
        blend: Blend::Additive, max_particles: 54, duration: 0.1, looping: false, z: 171.0, ..
    }, 1.8);
}

@system(in_state: [GameState::Playing])
fn fly_fire_bolts(shots: (Entity, FireBolt, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (se, b, t) in shots {
        b.vel = b.vel + vec2(0.0, b.gravity * time.dt);
        let step = b.vel * time.dt;
        let len = step.length();
        let hit_wall = false;
        if len > 0.0 {
            hit_wall = physics.raycast_mask(t.position, step * (1.0 / len), len, WALL_BITS).hit;
        }
        if in_wall(physics, t.position) {
            hit_wall = true;
        }
        b.life -= time.dt;
        t.position = t.position + step;
        let done = hit_wall || b.life <= 0.0;
        if !done {
            for (_, e, et) in enemies {
                if !done && t.position.distance(et.position) <= enemy_reach(et) {
                    damage_enemy(e, b.damage);
                    done = true;
                }
            }
        }
        if done {
            bolt_impact(cmd, t.position);
            cmd.despawn(se);
        }
    }
}

fn min_int_of(a: int, b: int) -> int {
    if a < b {
        return a;
    }
    return b;
}

@system(in_state: [GameState::Playing])
fn shield(player: (Entity, Player, Transform)[], st: AbilityState, input: Input, time: Time, cmd: Commands) {
    if !st.shield_on && st.shield_cd > 0.0 {
        st.shield_cd -= time.dt;
    }
    for (pe, p, t) in player {
        if !st.shield_on && st.shield_cd <= 0.0 && input.mouse_pressed(MouseButton::Right) {
            p.shield = true;
            st.shield_on = true;
            st.shield_left = SHIELD_TIME;
            st.shield_fx = cmd.spawn([
                Transform { position: t.position, .. },
                ParticleEmitter {
                    rate: 180.0, lifetime_min: 1.62, lifetime_max: 3.24, prewarm: 1.0,
                    speed_min: 2.0, speed_max: 12.0, drag: 1.2,
                    size_start: 9.0, size_start_max: 13.0, size_end: 2.0,
                    spin_min: -2.0, spin_max: 2.0,
                    color_start: Color { r: 0.55, g: 0.95, b: 1.0, a: 0.9 },
                    color_end: Color { r: 0.2, g: 0.5, b: 1.0, a: 0.0 },
                    shape: EmitShape::Ring, shape_radius: SHIELD_RADIUS,
                    local: true, blend: Blend::Additive, max_particles: 648, z: 210.0, ..
                },
            ]);
            burst(cmd, t.position, 40, 260.0, 9.0,
                  Color { r: 0.6, g: 0.95, b: 1.0, a: 1.0 }, Color { r: 0.2, g: 0.5, b: 1.0, a: 0.0 }, 0.5);
        }
        if st.shield_on {
            cmd.insert(st.shield_fx, Transform { position: t.position, .. });
            st.shield_left -= time.dt;
            if !p.shield || st.shield_left <= 0.0 {
                p.shield = false;
                st.shield_on = false;
                st.shield_cd = SHIELD_COOLDOWN;
                cmd.despawn(st.shield_fx);
                burst(cmd, t.position, 90, 420.0, 10.0,
                      Color { r: 0.75, g: 1.0, b: 1.0, a: 1.0 }, Color { r: 0.2, g: 0.4, b: 1.0, a: 0.0 }, 0.7);
            }
        }
    }
}

fn spawn_throw(cmd: Commands, from: Vec2, dir: Vec2, kind: string, level: int) {
    let glow = col(0.6, 0.8, 1.0, 1.0);
    let hot = col(0.95, 0.98, 1.0, 1.0);
    let cool = col(0.35, 0.45, 1.0, 0.0);
    if kind == "gas" {
        glow = col(0.45, 1.0, 0.3, 1.0);
        hot = col(0.7, 1.0, 0.4, 1.0);
        cool = col(0.2, 0.55, 0.05, 0.0);
    }
    let vel = dir * 760.0 + vec2(0.0, -300.0);
    let shot = cmd.spawn([
        Transform { position: from, rotation: vel.angle(), scale: vec2(3.0, 3.0), .. },
        Throw { kind: kind, vel: vel, level: level, .. },
        PointLight { color: glow, intensity: 2.0, radius: 240.0, falloff: 1.5, shadows: false, .. },
        ParticleEmitter {
            rate: 150.0, lifetime_min: 0.27, lifetime_max: 0.9,
            speed_min: 30.0, speed_max: 160.0, gravity: vec2(0.0, 600.0),
            size_start: 6.0, size_start_max: 9.0, size_end: 0.5,
            color_start: hot, color_end: cool,
            shape: EmitShape::Circle, shape_radius: 8.0, spin_min: -6.0, spin_max: 6.0,
            blend: Blend::Additive, max_particles: 216, z: 154.0, ..
        },
    ]);
    if kind == "chain" {
        cmd.insert(shot, Sprite { image: texture("assets/fx/chainBolt.png"), z: 155.0, .. });
    } else {
        cmd.insert(shot, Circle { radius: 4.0, color: hot, z: 155.0, .. });
    }
    burst(cmd, from, 18, 220.0, 7.0, hot, cool, 0.3);
}

@system(in_state: [GameState::Playing])
fn fly_throws(throws: (Entity, Throw, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (te, th, t) in throws {
        th.vel = th.vel + vec2(0.0, th.gravity * time.dt);
        let step = th.vel * time.dt;
        let len = step.length();
        let hit_wall = false;
        if len > 0.0 {
            let ray = physics.raycast_mask(t.position, step * (1.0 / len), len, WALL_BITS);
            if ray.hit {
                hit_wall = true;
                t.position = ray.point - step * (2.0 / len);
            }
        }
        if !hit_wall && in_wall(physics, t.position) {
            hit_wall = true;
        }
        if !hit_wall {
            t.position = t.position + step;
        }
        th.life -= time.dt;
        let hit = hit_wall || th.life <= 0.0;
        if th.kind != "gas" {
            for (_, _, et) in enemies {
                if t.position.distance(et.position) <= enemy_reach(et) {
                    hit = true;
                }
            }
        }
        if th.kind == "chain" {
            t.rotation = th.vel.angle();
        }
        if hit {
            if th.kind == "chain" {
                zap(cmd, t.position);
                chain_bolt(cmd, physics, t.position, enemies, 2 + th.level, 1);
            }
            if th.kind == "gas" {
                flash(cmd, t.position, col(0.45, 1.0, 0.3, 1.0), 5.0, 600.0, 0.2);
                burst(cmd, t.position, 140, 620.0, 14.0, col(0.75, 1.0, 0.45, 1.0), col(0.2, 0.5, 0.05, 0.0), 0.7);
                burst(cmd, t.position, 50, 260.0, 30.0, col(0.5, 0.9, 0.3, 0.6), col(0.2, 0.45, 0.1, 0.0), 1.0);
                spawn_gas(cmd, t.position, th.level);
            }
            cmd.despawn(te);
        }
    }
}
