import "drift" { * };
import "game_state.cdl" { * };
import "player.cdl" { * };
import "enemy.cdl" { * };
import "card.cdl" { * };

const BOLT_COOLDOWN: float = 0.35;
const BOLT_COST: int = 15;
const FIRE_COOLDOWN: float = 1.2;
const ICE_COOLDOWN: float = 0.6;
const CHAIN_COOLDOWN: float = 1.8;
const GAS_COOLDOWN: float = 3.5;
const CAST_OFFSET: float = 130.0;
const FIREBALL_SPEED: float = 720.0;
const FIREBALL_LOFT: float = 380.0;
const SHIELD_COOLDOWN: float = 8.0;
const SHIELD_TIME: float = 6.0;
const SHIELD_RADIUS: float = 150.0;
const MANA_REGEN: float = 10.0;
const MANA_PER_KILL: int = 6;
const FIRE_COST: int = 25;
const ICE_COST: int = 12;
const CHAIN_COST: int = 30;
const GAS_COST: int = 35;

@resource
struct AbilityState {
    applied: int = 0,
    bolt_cd: float = 0.0,
    mana_acc: float = 0.0,
    kills_seen: int = 0,
    selected: string = "firebolt",
    known: int = 0,
    shield_on: bool = false,
    shield_cd: float = 0.0,
    shield_left: float = 0.0,
    shield_fx: Entity = Entity { .. },
    fire_cd: float = 0.0,
    ice_cd: float = 0.0,
    chain_cd: float = 0.0,
    gas_cd: float = 0.0,
}

@component
struct Projectile {
    vel: Vec2 = Vec2 { .. },
    gravity: float = 900.0,
    life: float = 1.0,
}

@component
struct FireBolt {
    damage: int = 1,
}

@component
struct Fireball {
    damage: int = 4,
    radius: float = 470.0,
    smoke: Entity = Entity { .. },
    sparks: Entity = Entity { .. },
}

@component
struct IceKnife {
    damage: int = 1,
    slow: float = 2.0,
    hit: int[] = [],
    sparkle: Entity = Entity { .. },
}

@component
struct Fx {
    life: float = 1.0,
}

fn attack_slots(owned: Abilities) -> string[] {
    let slots: string[] = ["firebolt"];
    for a in owned.owned {
        if (a == "fireball" || a == "iceknife" || a == "chainbolt" || a == "gascloud") && !slots.contains(a) {
            slots.push(a);
        }
    }
    return slots;
}

fn enemy_reach(et: Transform) -> float {
    return 16.0 * et.scale.x + 12.0;
}

fn in_wall(physics: Physics, p: Vec2) -> bool {
    return physics.overlap_circle_mask(p, 3.0, WALL_BITS).len() > 0;
}

fn fall_step(shot: Projectile, dt: float) -> Vec2 {
    shot.vel = shot.vel + vec2(0.0, shot.gravity * dt);
    return shot.vel * dt;
}

fn hits_wall(physics: Physics, p: Vec2, step: Vec2) -> bool {
    let len = step.length();
    if len > 0.0 && physics.raycast_mask(p, step * (1.0 / len), len, WALL_BITS).hit {
        return true;
    }
    return in_wall(physics, p);
}

fn count_of(owned: Abilities, name: string) -> int {
    let n = 0;
    for a in owned.owned {
        if a == name {
            n += 1;
        }
    }
    return n;
}

fn col(r: float, g: float, b: float, a: float) -> Color {
    return Color { r: r, g: g, b: b, a: a };
}

fn fx(cmd: Commands, at_pos: Vec2, e: ParticleEmitter, life: float) -> Entity {
    return cmd.spawn([at(at_pos.x, at_pos.y), e, Fx { life: life }]);
}

fn flash(cmd: Commands, at_pos: Vec2, c: Color, intensity: float, radius: float, life: float) {
    cmd.spawn([
        at(at_pos.x, at_pos.y),
        PointLight { color: c, intensity: intensity, radius: radius, falloff: 1.4, shadows: false, .. },
        Fx { life: life },
    ]);
}

fn burst(cmd: Commands, at_pos: Vec2, count: int, speed_max: float, size: float, from: Color, to: Color, life: float) {
    cmd.spawn([
        at(at_pos.x, at_pos.y),
        ParticleEmitter {
            rate: 0.0, bursts: [Burst { count: count, .. }],
            lifetime_min: life * 0.4 * 1.8, lifetime_max: life * 1.8,
            speed_min: speed_max * 0.2, speed_max: speed_max,
            size_start: size, size_end: size * 0.15,
            color_start: from, color_end: to,
            drag: 1.5, blend: Blend::Additive,
            max_particles: count + 10, duration: 0.2, looping: false, z: 160.0, ..
        },
        Fx { life: life * 1.8 + 0.3 },
    ]);
}

@system(on_exit: GameState::MainMenu)
fn reset_abilities(st: AbilityState, cmd: Commands) {
    st.applied = 0;
    st.kills_seen = 0;
    st.selected = "firebolt";
    st.known = 0;
    st.shield_cd = 0.0;
    st.shield_left = 0.0;
    if st.shield_on {
        cmd.despawn(st.shield_fx);
        st.shield_on = false;
    }
    st.bolt_cd = 0.0;
    st.fire_cd = 0.0;
    st.ice_cd = 0.0;
    st.chain_cd = 0.0;
    st.gas_cd = 0.0;
}

@system(in_state: [GameState::Playing])
fn apply_picks(player: (Player, Transform)[], owned: Abilities, st: AbilityState, cmd: Commands) {
    for (p, t) in player {
        while st.applied < owned.owned.len() {
            let name = owned.owned[st.applied];
            if name == "health" {
                p.health = p.max_health;
                burst(cmd, t.position, 60, 260.0, 9.0,
                      col(0.4, 1.0, 0.5, 1.0), col(0.1, 0.8, 0.2, 0.0), 0.9);
            }
            if name == "maxhealth" {
                p.max_health += 1;
                p.health += 1;
                burst(cmd, t.position, 70, 300.0, 10.0,
                      col(1.0, 0.4, 0.45, 1.0), col(0.8, 0.1, 0.2, 0.0), 0.9);
            }
            if name == "maxmana" {
                p.max_mana += 10;
                p.mana = min_int(p.mana + 10, p.max_mana);
                burst(cmd, t.position, 70, 300.0, 10.0,
                      col(0.4, 0.6, 1.0, 1.0), col(0.15, 0.25, 0.9, 0.0), 0.9);
            }
            if name == "speed" {
                p.speed += 0.25;
                burst(cmd, t.position, 60, 320.0, 8.0,
                      col(0.5, 0.85, 1.0, 1.0), col(0.2, 0.4, 1.0, 0.0), 0.8);
            }
            st.applied += 1;
        }
    }
}

@system(in_state: [GameState::Playing])
fn cast_abilities(player: (Player, Transform)[], enemies: (Entity, Enemy, Transform)[], owned: Abilities, st: AbilityState, kills: Kills, input: Input, time: Time, physics: Physics, cmd: Commands) {
    st.bolt_cd -= time.dt;
    st.fire_cd -= time.dt;
    st.ice_cd -= time.dt;
    st.chain_cd -= time.dt;
    st.gas_cd -= time.dt;
    let gained = max_int(kills.count - st.kills_seen, 0);
    st.kills_seen = kills.count;
    for (p, _) in player {
        p.mana = min_int(p.mana + gained * MANA_PER_KILL, p.max_mana);
        if p.mana < p.max_mana {
            let fill = float(p.mana) / float(max_int(p.max_mana, 1));
            st.mana_acc += MANA_REGEN * (0.3 + 1.3 * fill) * time.dt;
            while st.mana_acc >= 1.0 && p.mana < p.max_mana {
                st.mana_acc -= 1.0;
                p.mana += 1;
            }
        } else {
            st.mana_acc = 0.0;
        }
    }
    let slots = attack_slots(owned);
    while st.known < owned.owned.len() {
        let name = owned.owned[st.known];
        if slots.contains(name) {
            st.selected = name;
        }
        st.known += 1;
    }
    let keys = [Key::Num1, Key::Num2, Key::Num3, Key::Num4, Key::Num5];
    for i in range(keys.len()) {
        if i < slots.len() && input.key_pressed(keys[i]) {
            st.selected = slots[i];
        }
    }
    let at_slot = 0;
    for i in range(slots.len()) {
        if slots[i] == st.selected {
            at_slot = i;
        }
    }
    if input.key_pressed(Key::E) {
        st.selected = slots[(at_slot + 1) % slots.len()];
    }
    if input.key_pressed(Key::Q) {
        st.selected = slots[(at_slot + slots.len() - 1) % slots.len()];
    }
    if !input.mouse_pressed(MouseButton::Left) {
        return;
    }
    let mouse = input.mouse_world();
    for (p, t) in player {
        let aim = mouse - t.position;
        if aim.length() < 1.0 {
            aim = vec2(1.0, 0.0);
        }
        aim = aim.normalized();
        let from = t.position + aim * CAST_OFFSET;
        let path = physics.raycast_mask(t.position, aim, CAST_OFFSET, WALL_BITS);
        if path.hit {
            from = path.point - aim * 2.0;
        }

        if st.selected == "firebolt" && st.bolt_cd <= 0.0 && pay(p, BOLT_COST) {
            st.bolt_cd = BOLT_COOLDOWN;
            spawn_fire_bolt(cmd, from, aim);
        }
        let fire = count_of(owned, "fireball");
        if st.selected == "fireball" && fire > 0 && st.fire_cd <= 0.0 && pay(p, FIRE_COST) {
            st.fire_cd = FIRE_COOLDOWN;
            spawn_fireball(cmd, from, aim, 1 + fire, 140.0 + 30.0 * float(fire));
        }
        let ice = count_of(owned, "iceknife");
        if st.selected == "iceknife" && ice > 0 && st.ice_cd <= 0.0 && pay(p, ICE_COST) {
            st.ice_cd = ICE_COOLDOWN;
            spawn_ice_knife(cmd, from, aim, ice);
        }
        let chain = count_of(owned, "chainbolt");
        if st.selected == "chainbolt" && chain > 0 && st.chain_cd <= 0.0 && pay(p, CHAIN_COST) {
            st.chain_cd = CHAIN_COOLDOWN;
            spawn_chain_bolt(cmd, from, aim, chain);
        }
        let gas = count_of(owned, "gascloud");
        if st.selected == "gascloud" && gas > 0 && st.gas_cd <= 0.0 && pay(p, GAS_COST) {
            st.gas_cd = GAS_COOLDOWN;
            spawn_gas_flask(cmd, from, mouse, gas);
        }
    }
}

fn pay(p: Player, cost: int) -> bool {
    if p.mana < cost {
        return false;
    }
    p.mana -= cost;
    return true;
}

fn spawn_fireball(cmd: Commands, from: Vec2, dir: Vec2, damage: int, radius: float) {
    let smoke = cmd.spawn([
        at(from.x, from.y),
        ParticleEmitter {
            rate: 45.0, lifetime_min: 1.44, lifetime_max: 2.88,
            speed_min: 5.0, speed_max: 30.0, gravity: vec2(0.0, -60.0), drag: 0.8,
            size_start: 14.0, size_start_max: 20.0, size_end: 46.0,
            color_start: col(0.35, 0.3, 0.28, 0.45), color_end: col(0.15, 0.13, 0.12, 0.0),
            spin_min: -1.5, spin_max: 1.5,
            blend: Blend::Alpha, max_particles: 162, z: 150.0, ..
        },
    ]);
    let sparks = cmd.spawn([
        at(from.x, from.y),
        ParticleEmitter {
            rate: 70.0, lifetime_min: 0.54, lifetime_max: 1.44,
            speed_min: 60.0, speed_max: 220.0, gravity: vec2(0.0, 700.0),
            size_start: 4.0, size_end: 0.5,
            color_start: col(1.0, 0.95, 0.6, 1.0), color_end: col(1.0, 0.35, 0.0, 0.0),
            blend: Blend::Additive, max_particles: 144, z: 156.0, ..
        },
    ]);
    cmd.spawn([
        at(from.x, from.y),
        Projectile { vel: dir * FIREBALL_SPEED - vec2(0.0, FIREBALL_LOFT), gravity: 900.0, life: 3.0 },
        Fireball { damage: damage, radius: radius, smoke: smoke, sparks: sparks },
        Circle { radius: 15.0, color: col(1.0, 0.9, 0.55, 1.0), z: 155.0, .. },
        PointLight { color: col(1.0, 0.55, 0.15, 1.0), intensity: 2.5, radius: 260.0, falloff: 1.5, shadows: false, .. },
        ParticleEmitter {
            rate: 220.0, lifetime_min: 0.36, lifetime_max: 0.99,
            speed_min: 10.0, speed_max: 70.0,
            size_start: 14.0, size_start_max: 22.0, size_end: 1.0,
            color_start: col(1.0, 0.75, 0.25, 1.0), color_end: col(0.85, 0.1, 0.0, 0.0),
            shape: EmitShape::Circle, shape_radius: 10.0, spin_min: -4.0, spin_max: 4.0,
            blend: Blend::Additive, max_particles: 360, z: 154.0, ..
        },
    ]);
    burst(cmd, from, 30, 260.0, 9.0, col(1.0, 0.85, 0.4, 1.0), col(1.0, 0.3, 0.0, 0.0), 0.35);
}

fn spawn_ice_knife(cmd: Commands, from: Vec2, dir: Vec2, damage: int) {
    let sparkle = cmd.spawn([
        at(from.x, from.y),
        ParticleEmitter {
            rate: 60.0, lifetime_min: 0.54, lifetime_max: 1.44,
            speed_min: 20.0, speed_max: 90.0, gravity: vec2(0.0, 120.0),
            size_start: 4.0, size_end: 0.5, rotation_min: 0.0, rotation_max: 6.28, spin_min: -6.0, spin_max: 6.0,
            color_start: col(1.0, 1.0, 1.0, 1.0), color_end: col(0.6, 0.85, 1.0, 0.0),
            blend: Blend::Additive, max_particles: 126, z: 157.0, ..
        },
    ]);
    cmd.spawn([
        Transform { position: from, rotation: dir.angle(), scale: vec2(2.5, 2.5), .. },
        Projectile { vel: dir * 600.0, gravity: 900.0, life: 2.0 },
        IceKnife { damage: damage, sparkle: sparkle, .. },
        Sprite { image: texture("assets/fx/iceKnife.png"), z: 155.0, .. },
        PointLight { color: col(0.55, 0.85, 1.0, 1.0), intensity: 1.6, radius: 220.0, falloff: 1.5, shadows: false, .. },
        ParticleEmitter {
            rate: 120.0, lifetime_min: 0.72, lifetime_max: 1.62,
            speed_min: 5.0, speed_max: 25.0, drag: 1.0,
            size_start: 16.0, size_start_max: 22.0, size_end: 34.0,
            shape: EmitShape::Circle, shape_radius: 10.0, spin_min: -1.0, spin_max: 1.0,
            color_start: col(0.75, 0.92, 1.0, 0.55), color_end: col(0.4, 0.6, 1.0, 0.0),
            blend: Blend::Alpha, max_particles: 234, z: 154.0, ..
        },
    ]);
    burst(cmd, from, 20, 200.0, 6.0, col(0.9, 1.0, 1.0, 1.0), col(0.4, 0.7, 1.0, 0.0), 0.3);
}

fn ice_shatter(cmd: Commands, at_pos: Vec2, big: bool) {
    let n = 26;
    if big {
        n = 50;
    }
    flash(cmd, at_pos, col(0.6, 0.9, 1.0, 1.0), 2.5, 260.0, 0.12);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: n, .. }],
        lifetime_min: 0.72, lifetime_max: 1.62, speed_min: 140.0, speed_max: 480.0, gravity: vec2(0.0, 1200.0),
        size_start: 6.0, size_start_max: 9.0, size_end: 1.0, rotation_min: 0.0, rotation_max: 6.28, spin_min: -9.0, spin_max: 9.0,
        color_start: col(0.92, 0.98, 1.0, 1.0), color_end: col(0.5, 0.75, 1.0, 0.0),
        blend: Blend::Additive, max_particles: n + 10, duration: 0.1, looping: false, z: 170.0, ..
    }, 2.16);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: n / 2, .. }],
        lifetime_min: 1.08, lifetime_max: 2.16, speed_min: 20.0, speed_max: 120.0, drag: 1.8,
        size_start: 22.0, size_end: 56.0, color_start: col(0.8, 0.93, 1.0, 0.5), color_end: col(0.5, 0.7, 1.0, 0.0),
        blend: Blend::Alpha, max_particles: n, duration: 0.1, looping: false, z: 166.0, ..
    }, 2.7);
}

fn explode(cmd: Commands, at_pos: Vec2, b: Fireball, enemies: (Entity, Enemy, Transform)[]) {
    for (_, e, et) in enemies {
        if at_pos.distance(et.position) <= b.radius {
            damage_enemy(e, b.damage);
        }
    }
    flash(cmd, at_pos, col(1.0, 0.6, 0.2, 1.0), 9.0, 900.0, 0.18);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 14, .. }],
        lifetime_min: 0.14, lifetime_max: 0.29, speed_min: 0.0, speed_max: 40.0,
        size_start: 120.0, size_end: 200.0, color_start: col(1.0, 1.0, 0.9, 1.0), color_end: col(1.0, 0.7, 0.3, 0.0),
        blend: Blend::Additive, max_particles: 36, duration: 0.1, looping: false, z: 170.0, ..
    }, 0.72);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 220, .. }],
        lifetime_min: 0.54, lifetime_max: 1.62, speed_min: 80.0, speed_max: 720.0, drag: 2.2,
        size_start: 18.0, size_start_max: 30.0, size_end: 2.0,
        color_start: col(1.0, 0.8, 0.3, 1.0), color_end: col(0.75, 0.05, 0.0, 0.0),
        spin_min: -6.0, spin_max: 6.0, blend: Blend::Additive, max_particles: 432, duration: 0.1, looping: false, z: 168.0, ..
    }, 2.16);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 90, .. }],
        lifetime_min: 0.45, lifetime_max: 0.81, speed_min: 900.0, speed_max: 1000.0, drag: 4.0,
        size_start: 10.0, size_end: 2.0, shape: EmitShape::Ring, shape_radius: 30.0,
        color_start: col(1.0, 0.95, 0.75, 0.9), color_end: col(1.0, 0.5, 0.1, 0.0),
        blend: Blend::Additive, max_particles: 180, duration: 0.1, looping: false, z: 169.0, ..
    }, 1.44);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 120, .. }],
        lifetime_min: 1.08, lifetime_max: 2.52, speed_min: 300.0, speed_max: 1100.0, gravity: vec2(0.0, 1400.0), drag: 0.6,
        size_start: 5.0, size_end: 1.0,
        color_start: col(1.0, 1.0, 0.7, 1.0), color_end: col(1.0, 0.35, 0.0, 0.0),
        blend: Blend::Additive, max_particles: 234, duration: 0.1, looping: false, z: 171.0, ..
    }, 3.24);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 70, .. }],
        lifetime_min: 2.7, lifetime_max: 5.4, speed_min: 20.0, speed_max: 220.0, gravity: vec2(0.0, -50.0), drag: 1.5,
        size_start: 4.0, size_start_max: 7.0, size_end: 1.0,
        color_start: col(1.0, 0.65, 0.2, 1.0), color_end: col(0.9, 0.2, 0.0, 0.0),
        shape: EmitShape::Circle, shape_radius: 60.0,
        blend: Blend::Additive, max_particles: 144, duration: 0.1, looping: false, z: 167.0, ..
    }, 5.94);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 55, .. }],
        lifetime_min: 2.52, lifetime_max: 4.68, speed_min: 30.0, speed_max: 180.0, gravity: vec2(0.0, -90.0), drag: 1.8,
        size_start: 30.0, size_start_max: 44.0, size_end: 110.0,
        color_start: col(0.28, 0.24, 0.22, 0.55), color_end: col(0.1, 0.09, 0.09, 0.0),
        shape: EmitShape::Circle, shape_radius: 50.0, spin_min: -1.0, spin_max: 1.0,
        blend: Blend::Alpha, max_particles: 108, duration: 0.1, looping: false, z: 165.0, ..
    }, 5.22);
}

@system(in_state: [GameState::Playing])
fn fly_fireballs(balls: (Entity, Projectile, Fireball, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (be, shot, b, t) in balls {
        let step = fall_step(shot, time.dt);
        let hit_wall = hits_wall(physics, t.position, step);
        shot.life -= time.dt;
        t.position = t.position + step;
        cmd.insert(b.smoke, Transform { position: t.position, .. });
        cmd.insert(b.sparks, Transform { position: t.position, .. });
        let boom = hit_wall || shot.life <= 0.0;
        for (_, _, et) in enemies {
            if t.position.distance(et.position) <= enemy_reach(et) {
                boom = true;
            }
        }
        if boom {
            explode(cmd, t.position, b, enemies);
            cmd.insert(b.smoke, Fx { life: 2.16 });
            cmd.insert(b.sparks, Fx { life: 0.9 });
            cmd.despawn(be);
        }
    }
}

@system(in_state: [GameState::Playing])
fn fly_ice_knives(knives: (Entity, Projectile, IceKnife, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (ke, shot, k, t) in knives {
        let step = fall_step(shot, time.dt);
        let hit_wall = hits_wall(physics, t.position, step);
        shot.life -= time.dt;
        t.position = t.position + step;
        t.rotation = shot.vel.angle();
        cmd.insert(k.sparkle, Transform { position: t.position, .. });
        for (id, e, et) in enemies {
            if t.position.distance(et.position) <= enemy_reach(et) + 14.0 && !k.hit.contains(id.id) {
                k.hit.push(id.id);
                damage_enemy(e, k.damage);
                e.slow_time = k.slow;
                ice_shatter(cmd, et.position, true);
            }
        }
        if hit_wall || shot.life <= 0.0 {
            ice_shatter(cmd, t.position, false);
            cmd.insert(k.sparkle, Fx { life: 1.44 });
            cmd.despawn(ke);
        }
    }
}

@system
fn fade_fx(fx: (Entity, Fx)[], time: Time, cmd: Commands) {
    for (e, f) in fx {
        f.life -= time.dt;
        if f.life <= 0.0 {
            cmd.despawn(e);
        }
    }
}

fn spawn_fire_bolt(cmd: Commands, from: Vec2, dir: Vec2) {
    cmd.spawn([
        at(from.x, from.y),
        Projectile { vel: dir * 950.0, gravity: 700.0, life: 1.0 },
        FireBolt { .. },
        Circle { radius: 8.0, color: col(1.0, 0.92, 0.6, 1.0), z: 155.0, .. },
        PointLight { color: col(1.0, 0.6, 0.2, 1.0), intensity: 1.4, radius: 160.0, falloff: 1.6, shadows: false, .. },
        ParticleEmitter {
            rate: 180.0, lifetime_min: 0.22, lifetime_max: 0.63,
            speed_min: 10.0, speed_max: 70.0,
            size_start: 9.0, size_start_max: 12.0, size_end: 0.5,
            color_start: col(1.0, 0.7, 0.2, 1.0), color_end: col(0.8, 0.1, 0.0, 0.0),
            shape: EmitShape::Circle, shape_radius: 4.0, spin_min: -5.0, spin_max: 5.0,
            blend: Blend::Additive, max_particles: 162, z: 154.0, ..
        },
    ]);
    burst(cmd, from, 16, 200.0, 7.0, col(1.0, 0.9, 0.5, 1.0), col(1.0, 0.3, 0.0, 0.0), 0.25);
}

fn bolt_impact(cmd: Commands, at_pos: Vec2) {
    flash(cmd, at_pos, col(1.0, 0.55, 0.2, 1.0), 3.0, 260.0, 0.1);
    burst(cmd, at_pos, 40, 340.0, 8.0, col(1.0, 0.85, 0.35, 1.0), col(0.8, 0.1, 0.0, 0.0), 0.45);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: 24, .. }],
        lifetime_min: 0.54, lifetime_max: 1.26, speed_min: 150.0, speed_max: 520.0, gravity: vec2(0.0, 1300.0),
        size_start: 3.5, size_end: 0.5, color_start: col(1.0, 1.0, 0.7, 1.0), color_end: col(1.0, 0.4, 0.0, 0.0),
        blend: Blend::Additive, max_particles: 54, duration: 0.1, looping: false, z: 171.0, ..
    }, 1.8);
}

@system(in_state: [GameState::Playing])
fn fly_fire_bolts(bolts: (Entity, Projectile, FireBolt, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (se, shot, b, t) in bolts {
        let step = fall_step(shot, time.dt);
        let hit_wall = hits_wall(physics, t.position, step);
        shot.life -= time.dt;
        t.position = t.position + step;
        let done = hit_wall || shot.life <= 0.0;
        if !done {
            for (_, e, et) in enemies {
                if !done && t.position.distance(et.position) <= enemy_reach(et) {
                    damage_enemy(e, b.damage);
                    done = true;
                }
            }
        }
        if done {
            bolt_impact(cmd, t.position);
            cmd.despawn(se);
        }
    }
}

@system(in_state: [GameState::Playing])
fn shield(player: (Entity, Player, Transform)[], st: AbilityState, input: Input, time: Time, cmd: Commands) {
    if !st.shield_on && st.shield_cd > 0.0 {
        st.shield_cd -= time.dt;
    }
    for (pe, p, t) in player {
        if !st.shield_on && st.shield_cd <= 0.0 && input.mouse_pressed(MouseButton::Right) {
            p.shield = true;
            st.shield_on = true;
            st.shield_left = SHIELD_TIME;
            st.shield_fx = cmd.spawn([
                Transform { position: t.position, .. },
                ParticleEmitter {
                    rate: 180.0, lifetime_min: 1.62, lifetime_max: 3.24, prewarm: 1.0,
                    speed_min: 2.0, speed_max: 12.0, drag: 1.2,
                    size_start: 9.0, size_start_max: 13.0, size_end: 2.0,
                    spin_min: -2.0, spin_max: 2.0,
                    color_start: col(0.55, 0.95, 1.0, 0.9),
                    color_end: col(0.2, 0.5, 1.0, 0.0),
                    shape: EmitShape::Ring, shape_radius: SHIELD_RADIUS,
                    local: true, blend: Blend::Additive, max_particles: 648, z: 210.0, ..
                },
            ]);
            burst(cmd, t.position, 40, 260.0, 9.0,
                  col(0.6, 0.95, 1.0, 1.0), col(0.2, 0.5, 1.0, 0.0), 0.5);
        }
        if st.shield_on {
            cmd.insert(st.shield_fx, Transform { position: t.position, .. });
            st.shield_left -= time.dt;
            if !p.shield || st.shield_left <= 0.0 {
                p.shield = false;
                st.shield_on = false;
                st.shield_cd = SHIELD_COOLDOWN;
                cmd.despawn(st.shield_fx);
                burst(cmd, t.position, 90, 420.0, 10.0,
                      col(0.75, 1.0, 1.0, 1.0), col(0.2, 0.4, 1.0, 0.0), 0.7);
            }
        }
    }
}

const CHAIN_SPEED: float = 2400.0;
const CHAIN_RANGE: float = 950.0;
const CHAIN_JUMP: float = 380.0;
const CHAIN_LIGHT: Color = Color { r: 0.6, g: 0.8, b: 1.0, a: 1.0 };

@component
struct ChainBolt {
    level: int = 1,
}

@component
struct LightningArc {
    points: Vec2[] = [],
    life: float = 0.32,
    age: float = 0.0,
}

fn spawn_chain_bolt(cmd: Commands, from: Vec2, dir: Vec2, level: int) {
    cmd.spawn([
        Transform { position: from, rotation: dir.angle(), scale: vec2(3.0, 3.0), .. },
        Projectile { vel: dir * CHAIN_SPEED, gravity: 0.0, life: CHAIN_RANGE / CHAIN_SPEED },
        ChainBolt { level: level },
        Sprite { image: texture("assets/fx/chainBolt.png"), z: 155.0, .. },
        PointLight { color: CHAIN_LIGHT, intensity: 2.4, radius: 260.0, falloff: 1.5, shadows: false, .. },
        ParticleEmitter {
            rate: 220.0, lifetime_min: 0.18, lifetime_max: 0.5,
            speed_min: 30.0, speed_max: 160.0,
            size_start: 6.0, size_start_max: 9.0, size_end: 0.5,
            color_start: col(0.95, 0.98, 1.0, 1.0), color_end: col(0.35, 0.45, 1.0, 0.0),
            shape: EmitShape::Circle, shape_radius: 8.0, spin_min: -6.0, spin_max: 6.0,
            blend: Blend::Additive, max_particles: 160, z: 154.0, ..
        },
    ]);
    burst(cmd, from, 18, 220.0, 7.0, col(0.95, 0.98, 1.0, 1.0), col(0.35, 0.45, 1.0, 0.0), 0.3);
}

@system(in_state: [GameState::Playing])
fn fly_chain_bolts(bolts: (Entity, Projectile, ChainBolt, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (be, shot, bolt, t) in bolts {
        let step = shot.vel * time.dt;
        let stop = hits_wall(physics, t.position, step);
        shot.life -= time.dt;
        let target = -1;
        let nearest = 1e9;
        let i = 0;
        for (_, e, et) in enemies {
            let rel = et.position - t.position;
            let along = clamp(rel.dot(step) / max(step.dot(step), 0.0001), 0.0, 1.0);
            let miss = (rel - step * along).length();
            if e.health > 0 && miss <= enemy_reach(et) && along < nearest {
                nearest = along;
                target = i;
            }
            i += 1;
        }
        if target >= 0 {
            chain_lightning(cmd, physics, t.position, enemies, target, bolt.level);
            cmd.despawn(be);
        } else if stop || shot.life <= 0.0 {
            zap(cmd, t.position, 0.5);
            cmd.despawn(be);
        } else {
            t.position = t.position + step;
        }
    }
}

fn chain_lightning(cmd: Commands, physics: Physics, from: Vec2, enemies: (Entity, Enemy, Transform)[], first: int, level: int) {
    let struck: int[] = [];
    let path: Vec2[] = [from];
    let here = from;
    let pick = first;
    let damage = 1 + level;
    for jump in range(2 + level) {
        if pick < 0 {
            break;
        }
        let i = 0;
        for (id, e, et) in enemies {
            if i == pick {
                struck.push(id.id);
                path.push(et.position);
                damage_enemy(e, damage);
                zap(cmd, et.position, 1.3);
                here = et.position;
            }
            i += 1;
        }
        damage = 1;
        pick = -1;
        let best = CHAIN_JUMP;
        i = 0;
        for (id, e, et) in enemies {
            let d = here.distance(et.position);
            if e.health > 0 && d > 1.0 && d <= best && !struck.contains(id.id) {
                if !physics.raycast_mask(here, (et.position - here).normalized(), d, WALL_BITS).hit {
                    best = d;
                    pick = i;
                }
            }
            i += 1;
        }
    }
    cmd.spawn([at(from.x, from.y), LightningArc { points: path, .. }]);
    for k in range(path.len() - 1) {
        spark_line(cmd, path[k], path[k + 1]);
    }
}

fn jagged(path: Vec2[], seed: int) -> Vec2[] {
    let out: Vec2[] = [];
    for k in range(path.len() - 1) {
        let a = path[k];
        let b = path[k + 1];
        let d = b - a;
        let steps = int(d.length() / 36.0) + 1;
        let side = vec2(-d.y, d.x).normalized();
        for i in range(steps) {
            let wobble = if i == 0 { 0.0 } else { sin(float(i * 7 + k * 13 + seed * 31) * 12.9898) * 22.0 };
            out.push(a + d * (float(i) / float(steps)) + side * wobble);
        }
    }
    out.push(path[path.len() - 1]);
    return out;
}

fn spark_line(cmd: Commands, a: Vec2, b: Vec2) {
    let d = b - a;
    let steps = int(d.length() / 48.0) + 1;
    for i in range(steps + 1) {
        let k = float(i) / float(steps);
        fx(cmd, a + d * k, ParticleEmitter {
            rate: 0.0, bursts: [Burst { count: 10, .. }],
            lifetime_min: 0.18, lifetime_max: 0.6, speed_min: 20.0, speed_max: 160.0, gravity: vec2(0.0, 900.0),
            size_start: 6.0, size_start_max: 9.0, size_end: 0.5,
            color_start: col(0.92, 0.97, 1.0, 1.0), color_end: col(0.45, 0.55, 1.0, 0.0),
            blend: Blend::Additive, max_particles: 25, duration: 0.1, looping: false, z: 172.0, ..
        }, 0.8);
    }
    flash(cmd, a + d * 0.5, CHAIN_LIGHT, 2.5, d.length() * 0.6 + 120.0, 0.15);
}

fn zap(cmd: Commands, at_pos: Vec2, size: float) {
    flash(cmd, at_pos, col(0.6, 0.75, 1.0, 1.0), 4.0 * size, 320.0 * size, 0.14);
    burst(cmd, at_pos, int(50.0 * size), 420.0 * size, 8.0, col(0.95, 0.98, 1.0, 1.0), col(0.4, 0.5, 1.0, 0.0), 0.45);
    fx(cmd, at_pos, ParticleEmitter {
        rate: 0.0, bursts: [Burst { count: int(40.0 * size), .. }],
        lifetime_min: 0.27, lifetime_max: 0.54, speed_min: 600.0 * size, speed_max: 700.0 * size, drag: 5.0, gravity: vec2(0.0, 900.0),
        size_start: 5.0, size_end: 1.0, shape: EmitShape::Ring, shape_radius: 16.0,
        color_start: col(0.85, 0.95, 1.0, 1.0), color_end: col(0.4, 0.5, 1.0, 0.0),
        blend: Blend::Additive, max_particles: 90, duration: 0.1, looping: false, z: 173.0, ..
    }, 1.08);
}

@system
fn draw_lightning(arcs: (Entity, LightningArc)[], draw: Draw, time: Time, cmd: Commands) {
    draw.overlay();
    for (e, arc) in arcs {
        arc.age += time.dt;
        if arc.age >= arc.life {
            cmd.despawn(e);
        } else {
            let fade = 1.0 - arc.age / arc.life;
            let points = jagged(arc.points, int(arc.age * 40.0));
            draw.polyline(points, col(0.45, 0.6, 1.0, 0.3 * fade), 22.0);
            draw.polyline(points, col(0.7, 0.85, 1.0, 0.7 * fade), 9.0);
            draw.polyline(points, col(1.0, 1.0, 1.0, fade), 3.0);
        }
    }
}

const GAS_RADIUS: float = 180.0;
const GAS_TICK: float = 0.75;
const GAS_LIFE: float = 3.0;
const GAS_FADE: float = 4.4;
const GAS_GLOW: Color = Color { r: 0.45, g: 1.0, b: 0.3, a: 1.0 };

@component
struct GasFlask {
    level: int = 1,
}

@component
struct GasCloud {
    radius: float = 180.0,
    damage: int = 1,
    tick: float = 0.0,
    life: float = 3.0,
    fade: float = 0.0,
    fall: float = 0.0,
    landed: bool = false,
    bubbles: Entity = Entity { .. },
}

const GAS_THROW_RANGE: float = 1100.0;
const GAS_GRAVITY: float = 1000.0;

fn spawn_gas_flask(cmd: Commands, from: Vec2, target: Vec2, level: int) {
    let hot = col(0.7, 1.0, 0.4, 1.0);
    let cool = col(0.2, 0.55, 0.05, 0.0);
    let to = target - from;
    if to.length() > GAS_THROW_RANGE {
        to = to.normalized() * GAS_THROW_RANGE;
    }
    let flight = clamp(to.length() / 900.0, 0.3, 1.2);
    let vel = vec2(to.x / flight, to.y / flight - 0.5 * GAS_GRAVITY * flight);
    cmd.spawn([
        Transform { position: from, rotation: vel.angle(), scale: vec2(3.0, 3.0), .. },
        Projectile { vel: vel, gravity: GAS_GRAVITY, life: 3.0 },
        GasFlask { level: level },
        Circle { radius: 6.0, color: hot, z: 155.0, .. },
        PointLight { color: GAS_GLOW, intensity: 2.0, radius: 240.0, falloff: 1.5, shadows: false, .. },
        ParticleEmitter {
            rate: 150.0, lifetime_min: 0.27, lifetime_max: 0.9,
            speed_min: 30.0, speed_max: 160.0, gravity: vec2(0.0, 600.0),
            size_start: 6.0, size_start_max: 9.0, size_end: 0.5,
            color_start: hot, color_end: cool,
            shape: EmitShape::Circle, shape_radius: 8.0, spin_min: -6.0, spin_max: 6.0,
            blend: Blend::Additive, max_particles: 216, z: 154.0, ..
        },
    ]);
    burst(cmd, from, 18, 220.0, 7.0, hot, cool, 0.3);
}

@system(in_state: [GameState::Playing])
fn fly_gas_flasks(flasks: (Entity, Projectile, GasFlask, Transform)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (fe, shot, flask, t) in flasks {
        let step = fall_step(shot, time.dt);
        let len = step.length();
        let burst_here = false;
        if len > 0.0 {
            let ray = physics.raycast_mask(t.position, step * (1.0 / len), len, WALL_BITS);
            if ray.hit {
                burst_here = true;
                t.position = ray.point - step * (2.0 / len);
            }
        }
        if !burst_here && in_wall(physics, t.position) {
            burst_here = true;
        }
        if !burst_here {
            t.position = t.position + step;
        }
        shot.life -= time.dt;
        for (_, e, et) in enemies {
            if e.health > 0 && t.position.distance(et.position) <= enemy_reach(et) {
                burst_here = true;
            }
        }
        if burst_here || shot.life <= 0.0 {
            flash(cmd, t.position, GAS_GLOW, 5.0, 600.0, 0.2);
            burst(cmd, t.position, 140, 620.0, 14.0, col(0.75, 1.0, 0.45, 1.0), col(0.2, 0.5, 0.05, 0.0), 0.7);
            burst(cmd, t.position, 50, 260.0, 30.0, col(0.5, 0.9, 0.3, 0.6), col(0.2, 0.45, 0.1, 0.0), 1.0);
            spawn_gas(cmd, t.position, flask.level);
            cmd.despawn(fe);
        }
    }
}

fn spawn_gas(cmd: Commands, where_at: Vec2, damage: int) {
    let bubbles = fx(cmd, where_at, ParticleEmitter {
        rate: 40.0, lifetime_min: 1.0, lifetime_max: 2.2,
        speed_min: 10.0, speed_max: 40.0, gravity: vec2(0.0, -70.0),
        size_start: 5.0, size_start_max: 9.0, size_end: 11.0,
        color_start: col(0.65, 1.0, 0.35, 0.9), color_end: col(0.3, 0.8, 0.1, 0.0),
        shape: EmitShape::Circle, shape_radius: GAS_RADIUS * 0.8,
        blend: Blend::Additive, max_particles: 126, z: 151.0, ..
    }, GAS_LIFE + 0.5);
    cmd.spawn([
        at(where_at.x, where_at.y),
        GasCloud { radius: GAS_RADIUS, damage: damage, life: GAS_LIFE, bubbles: bubbles, .. },
        PointLight { color: GAS_GLOW, intensity: 1.6, radius: GAS_RADIUS * 2.2, falloff: 1.2, shadows: false, .. },
        ParticleEmitter {
            rate: 120.0, lifetime_min: 1.6, lifetime_max: 3.2, prewarm: 0.6,
            speed_min: 5.0, speed_max: 35.0, drag: 0.8,
            size_start: 34.0, size_start_max: 52.0, size_end: 84.0,
            color_start: col(0.45, 0.9, 0.25, 0.6), color_end: col(0.18, 0.4, 0.08, 0.0),
            shape: EmitShape::Circle, shape_radius: GAS_RADIUS * 0.75,
            spin_min: -1.2, spin_max: 1.2,
            blend: Blend::Alpha, max_particles: 576, z: 150.0, ..
        },
    ]);
}

@system(in_state: [GameState::Playing])
fn gas_clouds(clouds: (Entity, GasCloud, Transform, ParticleEmitter, PointLight)[], enemies: (Entity, Enemy, Transform)[], physics: Physics, time: Time, cmd: Commands) {
    for (ce, c, t, smoke, glow) in clouds {
        if !c.landed {
            c.fall += 1400.0 * time.dt;
            let drop = c.fall * time.dt;
            let ground = physics.raycast_mask(t.position, vec2(0.0, 1.0), drop + 40.0, WALL_BITS);
            if ground.hit {
                t.position = vec2(t.position.x, ground.point.y - 40.0);
                c.landed = true;
                flash(cmd, t.position, GAS_GLOW, 2.0, 380.0, 0.2);
            } else {
                t.position = t.position + vec2(0.0, drop);
            }
            cmd.insert(c.bubbles, Transform { position: t.position, .. });
        } else if c.life > 0.0 {
            c.life -= time.dt;
            c.tick -= time.dt;
            if c.tick <= 0.0 {
                c.tick = GAS_TICK;
                let hurt = false;
                for (_, e, et) in enemies {
                    if e.health > 0 && t.position.distance(et.position) <= c.radius + enemy_reach(et) * 0.5 {
                        damage_enemy(e, c.damage);
                        burst(cmd, et.position, 16, 160.0, 9.0, col(0.7, 1.0, 0.4, 1.0), col(0.2, 0.5, 0.05, 0.0), 0.4);
                        hurt = true;
                    }
                }
                glow.intensity = if hurt { 2.6 } else { 1.8 };
            } else {
                glow.intensity = max(glow.intensity - 2.0 * time.dt, 1.4);
            }
        } else {
            smoke.rate = 0.0;
            c.fade += time.dt;
            glow.intensity = max(1.4 * (1.0 - c.fade / 1.2), 0.0);
            if c.fade >= GAS_FADE {
                cmd.despawn(ce);
            }
        }
    }
}

@system(in_state: [GameState::Playing])
fn draw_gas(clouds: (GasCloud, Transform)[], draw: Draw) {
    draw.overlay();
    for (c, t) in clouds {
        if c.landed && c.life > 0.0 {
            let a = 0.18 + 0.12 * min(c.life, 1.0);
            draw.circle_lines(t.position, c.radius, col(0.5, 1.0, 0.35, a), 3.0);
        }
    }
}
