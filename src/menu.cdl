import "drift" { * };
import "game_state.cdl" { * };
import "torches.cdl" { * };

@resource
struct UIArt {
    title: Texture = texture("assets/gameTitle.png"),
    start: Texture = texture("assets/gameStartButton.png"),
}

@component struct MainMenuUI {}

@component struct StartButton {}

@system(on_enter: GameState::MainMenu)
fn spawn_menu(cmd: Commands, window: Window, art: UIArt, torches: TorchSettings, torch_art: TorchAsset) {
    cmd.spawn([
        Transform { position: vec2(window.width * 0.5, window.height * 0.25), scale: vec2(6.0, 6.0), .. },
        Sprite { image: art.title, layer: hud_layer(), .. },
        MainMenuUI {},
    ]);
    cmd.spawn([
        Transform { position: vec2(window.width * 0.5, window.height * 0.55), scale: vec2(4.0, 4.0), .. },
        Sprite { image: art.start, layer: hud_layer(), .. },
        MainMenuUI {},
        StartButton {},
    ]);
    torch(cmd, vec2(window.width / 3.0 * 2.0, window.height * 1.7 / 3.0), torches, torch_art);
    torch(cmd, vec2(window.width / 3.0, window.height * 1.7 / 3.0), torches, torch_art);
}

@system(in_state: [GameState::MainMenu])
fn start_button(buttons: (StartButton, Sprite, Transform)[], input: Input, state: State<GameState>) {
    let m = input.mouse_screen();
    for (_, sprite, t) in buttons {
        if mouse_over(m, sprite.image.size(), t) {
            sprite.color = Color { r: 1.0, g: 0.85, b: 0.6, a: 1.0 };
            if input.mouse_pressed(MouseButton::Left) {
                state.set(GameState::Playing);
            }
        } else {
            sprite.color = Color { .. };
        }
    }
    if input.key_pressed(Key::Return) {
        state.set(GameState::Playing);
    }
}

@system(on_exit: GameState::MainMenu)
fn clear_menu(cmd: Commands, ui: (Entity, MainMenuUI)[]) {
    for (e, _) in ui {
        cmd.despawn(e);
    }
}
