import "drift" { * };

import "game_state.cdl" { * };

import "torches.cdl" { * };

@resource
struct UIArt {
    title: Texture = texture("assets/gameTitle.png"),
    start: Texture = texture("assets/gameStartButton.png"),
}

@component struct MainMenuUI {}

@component struct StartButton {}

@system(on_enter: GameState::MainMenu)
fn spawn_menu(cmd: Commands, assets: Assets, window: Window, art: UIArt, s: TorchSettings, art2: TorchAsset){
    cmd.spawn([
        Transform { 
            position: vec2(window.width/2, window.height/4), 
            scale: vec2(6.0, 6.0), 
            .. 
        },
        Sprite {
            image: art.title,
            layer: hud_layer(),
            ..
        },
        MainMenuUI {},
    ]);
    
    cmd.spawn([
        Transform { 
            position: vec2(window.width/2, window.height/2*1.1), 
            scale: vec2(4.0, 4.0), 
            .. 
        },
        Sprite {
            image: art.start,
            layer: hud_layer(),
            ..
        },

        MainMenuUI {},

        StartButton {},
    ]);
    let t = torch(cmd, vec2(window.width / 3 * 2, window.height * 1.7 / 3), s, art2, 56);
    // cmd.insert(t, MainMenuUI{});
    t = torch(cmd, vec2(window.width / 3, window.height * 1.7/ 3), s, art2, 56);
    // cmd.insert(t, MainMenuUI{});
}

@system(in_state: [GameState::MainMenu])
fn start_button(buttons: (StartButton, Sprite, Transform)[], input: Input, state: State<GameState>) {
    let m = input.mouse_screen();
    for (_, sprite, t) in buttons {
        let size = sprite.image.size();
        let hw = size.x * t.scale.x * 0.5;
        let hh = size.y * t.scale.y * 0.5;
        let over = m.x >= t.position.x - hw && m.x <= t.position.x + hw
                && m.y >= t.position.y - hh && m.y <= t.position.y + hh;
        if over {
            sprite.color = Color { r: 1.0, g: 0.85, b: 0.6, a: 1.0 };
            if input.mouse_pressed(MouseButton::Left) {
                state.set(GameState::Playing);
            }
        } else {
            sprite.color = Color { .. };
        }
    }
    if input.key_pressed(Key::Return) {
        state.set(GameState::Playing);
    }
}

@system(on_exit: GameState::MainMenu)
fn clear_menu(cmd: Commands, ui: (Entity, MainMenuUI)[]) {
    for (e, _) in ui {
        cmd.despawn(e);
    }
}
