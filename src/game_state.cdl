import "drift" { * };

@state enum GameState {
    MainMenu,
    Playing,
    PickingUpgrade,
}

const WALL_BITS: int = 1;
const PLAYER_BITS: int = 2;
const ENEMY_BITS: int = 4;

fn min_int(a: int, b: int) -> int {
    if a < b {
        return a;
    }
    return b;
}

fn mouse_over(m: Vec2, size: Vec2, t: Transform) -> bool {
    let hw = size.x * t.scale.x * 0.5;
    let hh = size.y * t.scale.y * 0.5;
    return m.x >= t.position.x - hw && m.x <= t.position.x + hw
        && m.y >= t.position.y - hh && m.y <= t.position.y + hh;
}
