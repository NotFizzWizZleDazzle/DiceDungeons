import "drift" { * };
import "game_state.cdl" { * };
import "player.cdl" { * };
import "dungeon.cdl" { * };
import "enemy_ai.cdl" { * };

// An enemy is a die: its health is the face it shows, so a d6 starts with up to six and a d4 with up to four.
// A d6 fights up close with a lunge; a d4 keeps its distance and shoots. How they decide is in enemy_ai.cdl.
@component
struct Enemy {
    health: int = 6,
    sides: int = 6,
    speed: float = 300.0,
    attack_cooldown: float = 1.2,
    melee_range: float = 190.0,     // d6: starts its lunge this close, centre to centre
    lunge_speed: float = 980.0,     // d6: the fastest sideways speed of its lunge
    shot_speed: float = 420.0,      // d4: bolt speed, pixels per second
    hurt_time: float = 0.0,
    roll_time: float = 0.0,
    roll_tick: float = 0.0,
    roll_face: int = 0,
    slow_time: float = 0.0,
    invuln: float = 0.0,
}

const HURT_TIME: float = 0.5;
const ENEMY_IFRAMES: float = 0.5;
const PLAYER_IFRAMES: float = 1.0;
const ROLL_TIME: float = 0.45;
const ROLL_STEP: float = 0.12;
const PLAYER_HIT_RADIUS: float = 110.0;

// A d4's shot.
@component
struct Bolt {
    dir: Vec2 = Vec2 { .. },
    speed: float = 420.0,
    life: float = 2.5,
}

@resource
struct Kills {
    count: int = 0,
    deaths: Vec2[] = [],
}

@resource
struct EnemyAssets {
    d6: Texture[] = [
        texture("assets/d6/1d6.png"),
        texture("assets/d6/2d6.png"),
        texture("assets/d6/3d6.png"),
        texture("assets/d6/4d6.png"),
        texture("assets/d6/5d6.png"),
        texture("assets/d6/6d6.png"),
    ],
    d4: Texture[] = [
        texture("assets/d4/1d4.png"),
        texture("assets/d4/2d4.png"),
        texture("assets/d4/3d4.png"),
        texture("assets/d4/4d4.png"),
    ],
}

@resource
struct EnemyWaves {
    every: int = 2,
    max_extra: int = 8,
    done: int[] = [],
}

fn faces_of(assets: EnemyAssets, sides: int) -> Texture[] {
    if sides == 4 {
        return assets.d4;
    }
    return assets.d6;
}

fn spawn_enemy(cmd: Commands, assets: EnemyAssets, pos: Vec2, sides: int) -> Entity {
    let r = rng(int(pos.x) + int(pos.y));
    let health = sides - r.range(0, sides - 1);
    return cmd.spawn([
        Enemy { sides: sides, health: health, .. },
        Brain { home_x: pos.x, goal_x: pos.x, think: r.range_float(0.0, 0.2), facing: r.sign(), .. },
        Transform { position: pos, scale: vec2(3.5, 3.5), .. },
        Sprite { image: faces_of(assets, sides)[health - 1], layer: 2, .. },
        RigidBody { .. },
        Velocity { .. },
        TextureCollider { category: ENEMY_BITS, .. },
    ]);
}

fn pick_sides(r: Rng, s: DungeonSettings) -> int {
    if r.chance(s.d4_chance) {
        return 4;
    }
    return 6;
}

// The enemies a chunk holds when it first streams in; more and likelier the deeper it is.
fn spawn_chunk_enemies(cmd: Commands, foes: EnemyAssets, s: DungeonSettings, r: Rng, index: int, left: float, span: float, floor_y: float) {
    let depth = index - s.safe_chunks;
    let tries = s.max_enemies + depth / max_int(s.enemy_ramp, 1);
    let chance = min(s.enemy_chance + s.enemy_chance_step * float(depth), 0.95);
    for i in range(tries) {
        if r.chance(chance) {
            let sides = pick_sides(r, s);
            let x = left + span * r.range_float(0.15, 0.85);
            let e = spawn_enemy(cmd, foes, vec2(x, floor_y - 120.0), sides);
            cmd.insert(e, Chunk { index: index });
        }
    }
}

fn damage_enemy(e: Enemy, amount: int) {
    if e.invuln > 0.0 || e.health <= 0 {
        return;
    }
    e.invuln = ENEMY_IFRAMES;
    e.roll_face = e.health;
    e.health = max_int(e.health - amount, 0);
    e.hurt_time = HURT_TIME;
    e.roll_time = ROLL_TIME;
    e.roll_tick = ROLL_STEP;
}

// Takes one heart, or the shield, and knocks the player away from `from`; the last heart ends the run.
fn hurt_player(cmd: Commands, p: Player, e: Entity, pt: Transform, pv: Velocity, state: State<GameState>, from: Vec2) {
    if p.invuln > 0.0 {
        return;
    }
    if p.shield {
        p.shield = false;
        p.invuln = 0.4;
        return;
    }
    p.invuln = PLAYER_IFRAMES;
    p.health = max_int(p.health - 1, 0);
    let away = 1.0;
    if pt.position.x < from.x {
        away = -1.0;
    }
    pv.linear = vec2(pv.linear.x + away * 1500.0, -420.0);
    if p.health == 0 {
        state.set(GameState::MainMenu);
        cmd.despawn(e);
    }
}

fn spawn_bolt(cmd: Commands, from: Vec2, dir: Vec2, speed: float) {
    cmd.spawn([
        at(from.x, from.y),
        Bolt { dir: dir, speed: speed, .. },
        Circle { radius: 7.0, color: Color { r: 0.75, g: 0.9, b: 1.0, a: 1.0 }, z: 150.0, .. },
        ParticleEmitter {
            rate: 70.0, lifetime_min: 0.36, lifetime_max: 0.9,
            speed_min: 5.0, speed_max: 30.0,
            size_start: 6.0, size_end: 0.5,
            color_start: Color { r: 0.55, g: 0.8, b: 1.0, a: 1.0 },
            color_end: Color { r: 0.3, g: 0.2, b: 1.0, a: 0.0 },
            blend: Blend::Additive, max_particles: 115, z: 149.0, ..
        },
    ]);
}

@system(in_state: [GameState::Playing])
fn bolts(shots: (Entity, Bolt, Transform)[], player: (Player, Transform, Velocity, Entity)[], physics: Physics, time: Time, cmd: Commands, state: State<GameState>) {
    for (be, b, t) in shots {
        let step = b.speed * time.dt;
        let wall = physics.raycast_mask(t.position, b.dir, step, WALL_BITS);
        b.life -= time.dt;
        let done = wall.hit || b.life <= 0.0;
        t.position = t.position + b.dir * step;
        for (p, pt, pv, pe) in player {
            if !done && t.position.distance(pt.position) <= PLAYER_HIT_RADIUS {
                hurt_player(cmd, p, pe, pt, pv, state, t.position);
                done = true;
            }
        }
        if done {
            cmd.despawn(be);
        }
    }
}

@system(on_exit: GameState::MainMenu)
fn new_dungeon(s: DungeonSettings, st: DungeonState, waves: EnemyWaves, random: Random, assets: Assets, window: Window, chunks: (Entity, Chunk)[], bounds: (Entity, DungeonBounds)[], cmd: Commands) {
    s.seed = random.stream("dungeon").range(1, 1000000000);
    for (e, _) in chunks {
        cmd.despawn(e);
    }
    for (e, _) in bounds {
        cmd.despawn(e);
    }
    st.spawned = [];
    waves.done = [];
    start_dungeon(assets, window, s, st);
}

// Extra enemies in every chunk past the safe ones, one more each `every` chunks.
@system(in_state: [GameState::Playing], after: [stream_dungeon])
fn enemy_waves(s: DungeonSettings, st: DungeonState, waves: EnemyWaves, foes: EnemyAssets, cmd: Commands) {
    let kept: int[] = [];
    for i in waves.done {
        if st.spawned.contains(i) {
            kept.push(i);
        }
    }
    waves.done = kept;
    for index in st.spawned {
        if !waves.done.contains(index) {
            waves.done.push(index);
            if index >= s.safe_chunks {
                let extra = min_int(index / max_int(waves.every, 1), waves.max_extra);
                let r = rng(s.seed + index * 1013 + 5);
                let left = float(index * st.chunk_w) * s.scale;
                let span = float(st.chunk_w) * s.scale;
                let floor_y = st.floor_top * s.scale;
                for n in range(extra) {
                    let sides = pick_sides(r, s);
                    let x = left + span * r.range_float(0.1, 0.9);
                    let e = spawn_enemy(cmd, foes, vec2(x, floor_y - 120.0), sides);
                    cmd.insert(e, Chunk { index: index });
                }
            }
        }
    }
}

fn death_burst(cmd: Commands, pos: Vec2) {
    cmd.spawn([
        at(pos.x, pos.y),
        ParticleEmitter {
            rate: 0.0, bursts: [Burst { count: 70, .. }],
            lifetime_min: 0.9, lifetime_max: 2.34, speed_min: 150.0, speed_max: 620.0,
            gravity: vec2(0.0, 1500.0), drag: 0.4,
            size_start: 9.0, size_start_max: 14.0, size_end: 2.0,
            rotation_min: 0.0, rotation_max: 6.28, spin_min: -10.0, spin_max: 10.0,
            color_start: Color { r: 1.0, g: 0.97, b: 0.9, a: 1.0 },
            color_end: Color { r: 0.8, g: 0.75, b: 0.7, a: 0.0 },
            max_particles: 144, duration: 0.1, looping: false, z: 165.0, ..
        },
        Lifetime { seconds: 2.88 },
    ]);
    cmd.spawn([
        at(pos.x, pos.y),
        ParticleEmitter {
            rate: 0.0, bursts: [Burst { count: 24, .. }],
            lifetime_min: 1.08, lifetime_max: 2.16, speed_min: 30.0, speed_max: 140.0,
            gravity: vec2(0.0, -60.0), drag: 1.6,
            size_start: 26.0, size_end: 60.0,
            color_start: Color { r: 0.9, g: 0.85, b: 0.8, a: 0.45 },
            color_end: Color { r: 0.5, g: 0.45, b: 0.45, a: 0.0 },
            max_particles: 54, duration: 0.1, looping: false, z: 164.0, ..
        },
        Lifetime { seconds: 2.7 },
    ]);
}

// A hit enemy rolls down, face by face, to its new health; at zero it bursts.
@system(in_state: [GameState::Playing])
fn enemy_faces(enemies: (Entity, Enemy, Sprite, Transform)[], assets: EnemyAssets, kills: Kills, time: Time, cmd: Commands) {
    for (id, e, sprite, t) in enemies {
        if e.invuln > 0.0 {
            e.invuln -= time.dt;
        }
        let faces = faces_of(assets, e.sides);
        if e.roll_time > 0.0 {
            e.roll_tick -= time.dt;
            if e.roll_tick <= 0.0 {
                e.roll_tick = ROLL_STEP;
                if e.roll_face > e.health {
                    e.roll_face -= 1;
                }
                if e.roll_face > e.health && e.roll_face >= 1 && e.roll_face <= faces.len() {
                    sprite.image = faces[e.roll_face - 1];
                } else {
                    e.roll_time = 0.0;
                }
            }
            if e.roll_time <= 0.0 {
                if e.health <= 0 {
                    kills.count += 1;
                    kills.deaths.push(t.position);
                    death_burst(cmd, t.position);
                    cmd.despawn(id);
                } else {
                    sprite.image = faces[min_int(e.health, faces.len()) - 1];
                }
            }
        }
        if e.hurt_time > 0.0 {
            e.hurt_time = max(e.hurt_time - time.dt, 0.0);
            let k = e.hurt_time / HURT_TIME;
            sprite.color = Color { r: 1.0, g: 1.0 - 0.8 * k, b: 1.0 - 0.8 * k, a: 1.0 };
        } else {
            sprite.color = Color { .. };
        }
    }
}
