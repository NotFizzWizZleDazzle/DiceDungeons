const D6: string = "assets/d6/";
const TOP: string = "assets/topSprites/";

const sides: int = 3;

@component struct Dice {

}

@settings(section: "settings")
struct Settings {}



@system(schedule: Schedule::Startup)
fn build_dungeon(
    assets: Assets, 
    dg: DungeonSettings, 
    window: Window, 
    st: DungeonState, 
    cmd: Commands, 
    art: TorchAsset, 
    ts: TorchSettings
) {
    art.sprite = texture(ts.sprite);
    let o = start_dungeon(assets, window, dg, st);
    cmd.spawn([
        BoxCollider { half_size: vec2(0.5, window.height * .5), friction: 1, .. },
        at(-1.0, window.height * 0.5),
    ]);
}

@system(schedule: Schedule::Startup)
fn load(cmd: Commands, window: Window, state: State<GameState>) {
    state.set(GameState::MainMenu);

    cmd.spawn([
        Camera { .. },
        CameraBounds {
            area: Rect { y: 0.0 - 80.0, h: window.height, x: 0.0, w: 100000.0 },
            ..
        }
    ]);
}

