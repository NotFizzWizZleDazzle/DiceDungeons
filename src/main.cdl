import "drift" { * };
import "drift/debug" { * };
import "game_state.cdl" { * };
import "dungeon.cdl" { * };
import "torches.cdl" { * };
import "menu.cdl" { * };
import "player.cdl" { * };
import "enemy.cdl" { * };
import "enemy_ai.cdl" { * };
import "card.cdl" { * };
import "ability.cdl" { * };
import "hud.cdl" { * };

@system(schedule: Schedule::Startup)
fn build_dungeon(assets: Assets, settings: DungeonSettings, window: Window, dungeon: DungeonState, cmd: Commands, torch_art: TorchAsset, torches: TorchSettings) {
    torch_art.sprite = texture(torches.sprite);
    start_dungeon(assets, window, settings, dungeon);
    // The wall at the left end of the dungeon.
    cmd.spawn([
        BoxCollider { half_size: vec2(0.5, window.height * 0.5), friction: 1.0, .. },
        at(-1.0, window.height * 0.5),
    ]);
}

@system(schedule: Schedule::Startup)
fn spawn_camera(cmd: Commands, window: Window, state: State<GameState>) {
    state.set(GameState::MainMenu);
    cmd.spawn([
        Camera { .. },
        CameraBounds {
            area: Rect { x: 0.0, y: -80.0, w: 100000.0, h: window.height },
            ..
        },
    ]);
}
