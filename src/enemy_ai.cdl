import "drift" { * };
import "drift/ai" { * };
import "game_state.cdl" { * };
import "player.cdl" { * };
import "enemy.cdl" { * };
import "card.cdl" { * };
import "ability.cdl" { * };

enum Mode { Patrol, Notice, Chase, Windup, Strike, Recover, Retreat, Search }

@settings(section: "enemy_ai")
struct EnemyAiSettings {
    difficulty: float = 1.0,
    sight: float = 1100.0,
    hearing: float = 300.0,
    reaction: float = 0.45,
    alert_radius: float = 900.0,
    forget_after: float = 0.8,
    search_time: float = 4.0,
    patrol_span: float = 260.0,
    melee_windup: float = 0.55,
    melee_attackers: int = 2,
    ranged_aim: float = 0.75,
    ranged_lock: float = 0.25,
    ranged_gap: float = 0.5,
    ranged_min: float = 420.0,
    ranged_max: float = 950.0,
    aim_lead: float = 0.7,
    min_hit_chance: float = 0.35,
    dodge: float = 0.4,
    think_rate: float = 8.0,
    log_states: bool = false,
    show_states: bool = false,
}

@component
struct Brain {
    mode: Fsm<Mode> = fsm(Mode::Patrol),
    entered: bool = true,
    home_x: float = 0.0,
    goal_x: float = 0.0,
    facing: float = 1.0,
    sees: bool = false,
    last_seen: Vec2 = Vec2 { .. },
    unseen: float = 0.0,
    think: float = 0.0,
    pause: float = 0.0,
    cooldown: float = 0.0,
    reaction: float = 0.0,
    side: float = 1.0,
    aim: Vec2 = Vec2 { .. },
    struck: bool = false,
    landed: bool = false,
    grounded: bool = false,
    blocked: bool = false,
    dodge_cd: float = 0.0,
    jump_cd: float = 0.0,
    last_hurt: float = 0.0,
}

@resource
struct EnemyDirector {
    attackers: int = 0,
    left: int = 0,
    right: int = 0,
    shot_gap: float = 0.0,
    alarms: Vec2[] = [],
    raised: Vec2[] = [],
    xs: float[] = [],
    ys: float[] = [],
    threat: int = 1,
    can_cast: bool = true,
    player_health: int = 3,
    rng: Rng = rng(1),
    seeded: bool = false,
}

const GRAVITY: float = 2400.0;
const MELEE_HIT: float = 140.0;
const WAIT_RING: float = 170.0;
const MAX_JUMP: float = 330.0;
const ARRIVE: float = 24.0;
const SAFE_DISTANCE: float = 720.0;

fn mode_name(m: Mode) -> string {
    return match m {
        Mode::Patrol => "patrol",
        Mode::Notice => "notice",
        Mode::Chase => "chase",
        Mode::Windup => "windup",
        Mode::Strike => "strike",
        Mode::Recover => "recover",
        Mode::Retreat => "retreat",
        Mode::Search => "search",
    };
}

fn kind_name(e: Enemy) -> string {
    return "d" + string(e.sides);
}

fn tempo(s: EnemyAiSettings) -> float {
    return 0.5 + 0.5 * clamp(s.difficulty, 0.25, 2.0);
}

fn max_attackers(s: EnemyAiSettings) -> int {
    return max_int(int(float(s.melee_attackers) * clamp(s.difficulty, 0.5, 2.0) + 0.5), 1);
}

fn change(b: Brain, e: Enemy, id: Entity, to: Mode, why: string, s: EnemyAiSettings) {
    if b.mode.now == to {
        return;
    }
    if s.log_states {
        log("[ai] " + kind_name(e) + "#" + string(id.id) + " " + mode_name(b.mode.now) + " -> " + mode_name(to) + " (" + why + ")");
    }
    b.mode.go(to);
    b.entered = true;
    if to == Mode::Notice {
        b.reaction = s.reaction / tempo(s) * (0.8 + 0.04 * float(id.id % 11));
    }
}

fn is_engaged(m: Mode) -> bool {
    return m == Mode::Chase || m == Mode::Windup || m == Mode::Strike || m == Mode::Recover;
}

fn is_calm(m: Mode) -> bool {
    return m == Mode::Patrol || m == Mode::Search;
}

fn half_height(t: Transform) -> float {
    return 16.0 * t.scale.y;
}

fn spell_damage(st: AbilityState, owned: Abilities) -> int {
    let n = max_int(count_of(owned, st.selected), 1);
    if st.selected == "fireball" || st.selected == "chainbolt" {
        return 1 + n;
    }
    if st.selected == "gascloud" {
        return 2 * n;
    }
    if st.selected == "iceknife" {
        return n;
    }
    return 1;
}

fn spell_cost(st: AbilityState) -> int {
    if st.selected == "fireball" {
        return FIRE_COST;
    }
    if st.selected == "iceknife" {
        return ICE_COST;
    }
    if st.selected == "chainbolt" {
        return CHAIN_COST;
    }
    if st.selected == "gascloud" {
        return GAS_COST;
    }
    return BOLT_COST;
}

fn aim_lead(s: EnemyAiSettings) -> float {
    return clamp(s.aim_lead * min(s.difficulty, 1.3), 0.0, 1.0);
}

fn hit_chance(from: Vec2, target: Vec2, target_vel: Vec2, shot_speed: float, s: EnemyAiSettings) -> float {
    let flight = from.distance(target) / max(shot_speed, 1.0);
    let drift = target_vel.length() * flight * (1.0 - aim_lead(s) * 0.8);
    return clamp(1.0 - drift / (PLAYER_HIT_RADIUS * 4.0), 0.05, 1.0);
}

enum Stance { Attack, Retreat }

fn stance(e: Enemy, d: EnemyDirector, allies_near: int, cornered: bool) -> Stance {
    let pips = float(e.health) / float(e.sides);
    let attack = 0.4 + 0.3 * pips + 0.1 * float(min_int(allies_near, 3));
    if !d.can_cast {
        attack += 0.6;
    }
    if d.player_health <= 1 {
        attack += 0.4;
    }
    let retreat = 0.0;
    if d.can_cast && d.threat >= e.health {
        retreat += 0.7;
    }
    if e.health == 1 {
        retreat += 0.2;
    }
    if cornered {
        retreat = 0.0;
    }
    let pick = choice<Stance>().consider(Stance::Attack, attack).consider(Stance::Retreat, retreat);
    return match pick.best() {
        Some(x) => x,
        None => Stance::Attack,
    };
}

@system(in_state: [GameState::Playing])
fn enemy_director(d: EnemyDirector, enemies: (Enemy, Brain, Transform)[], players: (Player, Transform)[], st: AbilityState, owned: Abilities, random: Random, time: Time) {
    if !d.seeded {
        d.rng = random.stream("enemy_ai");
        d.seeded = true;
    }
    d.attackers = 0;
    d.left = 0;
    d.right = 0;
    d.shot_gap = max(d.shot_gap - time.dt, 0.0);
    d.alarms = d.raised;
    d.raised = [];
    d.xs = [];
    d.ys = [];
    let px = 0.0;
    for (p, pt) in players {
        px = pt.position.x;
        d.threat = spell_damage(st, owned);
        d.can_cast = p.mana >= spell_cost(st);
        d.player_health = p.health;
    }
    for (e, b, t) in enemies {
        d.xs.push(t.position.x);
        d.ys.push(t.position.y);
        if e.sides == 6 && is_engaged(b.mode.now) {
            if b.mode.now == Mode::Windup || b.mode.now == Mode::Strike {
                d.attackers += 1;
            }
            if t.position.x < px {
                d.left += 1;
            } else {
                d.right += 1;
            }
        }
    }
}

@system(in_state: [GameState::Playing], after: [enemy_director])
fn enemy_think(
    enemies: (Entity, Enemy, Brain, Transform)[],
    players: (Player, Transform, Velocity)[],
    shots: (Projectile, Transform)[],
    d: EnemyDirector,
    s: EnemyAiSettings,
    physics: Physics,
    time: Time
) {
    if players.len() == 0 {
        return;
    }
    let player = players[0].1.position;
    let player_vel = players[0].2.linear;
    let dt = time.dt;
    let pace = tempo(s);
    let attackers = max_attackers(s);

    for (id, e, b, t) in enemies {
        b.mode.tick(dt);
        b.cooldown -= dt;
        b.dodge_cd -= dt;
        b.jump_cd -= dt;
        b.unseen += dt;
        let pos = t.position;
        let to = player - pos;
        let dist = to.length();

        let hit = e.hurt_time > b.last_hurt + 0.0001;
        b.last_hurt = e.hurt_time;
        if hit {
            b.last_seen = player;
            b.unseen = 0.0;
            b.facing = sign(to.x);
            if is_calm(b.mode.now) || b.mode.now == Mode::Notice {
                d.raised.push(pos);
                change(b, e, id, Mode::Chase, "hit", s);
            }
        }

        if is_calm(b.mode.now) {
            for (_, st) in shots {
                if st.position.distance(pos) < s.hearing {
                    b.last_seen = player;
                    b.unseen = 0.0;
                    d.raised.push(pos);
                    change(b, e, id, Mode::Notice, "heard a spell", s);
                }
            }
        }

        if is_calm(b.mode.now) {
            for a in d.alarms {
                if a.distance(pos) < s.alert_radius {
                    b.last_seen = player;
                    b.unseen = 0.0;
                    change(b, e, id, Mode::Notice, "alarm", s);
                }
            }
        }

        b.think -= dt;
        let look = b.think <= 0.0;
        if look {
            b.think = 1.0 / max(s.think_rate, 1.0);
            b.sees = false;
        }
        if look && dist > 1.0 && dist <= s.sight {
            let in_front = to.x * b.facing > 0.0 || dist <= s.hearing;
            let alert = !is_calm(b.mode.now);
            if in_front || alert {
                let eye = pos - vec2(0.0, half_height(t) * 0.5);
                let ray = player - eye;
                b.sees = !physics.raycast_mask(eye, ray.normalized(), ray.length(), WALL_BITS).hit;
            }
        }
        if b.sees {
            b.last_seen = player;
            b.unseen = 0.0;
        }

        let allies = 0;
        for i in range(d.xs.len()) {
            let gap = (d.xs[i] - pos.x).abs();
            if gap > 1.0 && gap < 500.0 {
                allies += 1;
            }
        }
        let cornered = pos.x < 260.0 || (b.mode.now == Mode::Retreat && b.blocked);
        let melee = e.sides == 6;
        let now = b.mode.now;

        if now == Mode::Patrol {
            if b.sees {
                d.raised.push(pos);
                change(b, e, id, Mode::Notice, "saw the player", s);
            }
        } else if now == Mode::Notice {
            b.facing = sign(b.last_seen.x - pos.x);
            if b.mode.time >= b.reaction {
                if b.unseen > s.forget_after {
                    change(b, e, id, Mode::Search, "lost sight", s);
                } else if stance(e, d, allies, cornered) == Stance::Retreat {
                    change(b, e, id, Mode::Retreat, "too risky", s);
                } else {
                    change(b, e, id, Mode::Chase, "reacted", s);
                }
            }
        } else if now == Mode::Chase {
            if b.unseen > s.forget_after {
                change(b, e, id, Mode::Search, "lost sight", s);
            } else if b.mode.time > 0.6 && stance(e, d, allies, cornered) == Stance::Retreat {
                change(b, e, id, Mode::Retreat, "player could finish it", s);
            } else if melee {
                let my_side = sign(pos.x - player.x);
                let mine = if my_side < 0.0 { d.left } else { d.right };
                let theirs = if my_side < 0.0 { d.right } else { d.left };
                let room = my_side < 0.0 || player.x > 450.0;
                b.side = my_side;
                if mine >= 2 && theirs == 0 && dist > e.melee_range && room {
                    b.side = -my_side;
                }
                let close = (to.x).abs() <= e.melee_range && to.y.abs() < 170.0;
                if close && b.sees && b.cooldown <= 0.0 && b.grounded && d.attackers < attackers {
                    d.attackers += 1;
                    b.aim = player;
                    change(b, e, id, Mode::Windup, "in reach", s);
                }
            } else {
                let chance = hit_chance(pos, player, player_vel, e.shot_speed, s);
                let in_band = dist >= s.ranged_min * 0.75 && dist <= s.sight;
                if b.sees && in_band && b.cooldown <= 0.0 && d.shot_gap <= 0.0 && chance >= s.min_hit_chance {
                    d.shot_gap = s.ranged_gap / pace;
                    b.aim = player;
                    change(b, e, id, Mode::Windup, "clear shot, " + string(int(chance * 100.0)) + "% to hit", s);
                }
            }
        } else if now == Mode::Windup {
            let length = if melee { s.melee_windup } else { s.ranged_aim };
            if !melee && b.mode.time < (length - s.ranged_lock) / pace {
                let flight = pos.distance(player) / max(e.shot_speed, 1.0);
                b.aim = player + player_vel * flight * aim_lead(s);
            }
            if b.mode.time >= length / pace {
                change(b, e, id, Mode::Strike, if melee { "lunge" } else { "fire" }, s);
            }
        } else if now == Mode::Strike {
            let done = if melee { b.mode.time > 0.25 && b.grounded || b.mode.time > 1.0 } else { true };
            if done {
                b.cooldown = e.attack_cooldown / pace;
                let how = if !melee { "shot" } else if b.landed { "hit" } else { "missed" };
                change(b, e, id, Mode::Recover, how, s);
            }
        } else if now == Mode::Recover {
            if b.mode.time >= 0.5 / pace {
                change(b, e, id, Mode::Chase, "recovered", s);
            }
        } else if now == Mode::Retreat {
            if cornered {
                change(b, e, id, Mode::Chase, "cornered", s);
            } else if b.mode.time > 1.0 && stance(e, d, allies, false) == Stance::Attack {
                let why = if d.can_cast { "player can't finish it" } else { "player out of mana" };
                change(b, e, id, Mode::Chase, why, s);
            } else if b.unseen > s.search_time {
                b.home_x = pos.x;
                change(b, e, id, Mode::Patrol, "lost track", s);
            }
        } else if now == Mode::Search {
            if b.sees {
                change(b, e, id, Mode::Chase, "found the player", s);
            } else if b.mode.time > s.search_time {
                b.home_x = pos.x;
                change(b, e, id, Mode::Patrol, "gave up", s);
            }
        }
    }
}

@system(in_state: [GameState::Playing], after: [enemy_think])
fn enemy_steer(
    enemies: (Entity, Enemy, Brain, Transform, Velocity)[],
    players: (Player, Transform)[],
    shots: (Projectile, Transform)[],
    clouds: (GasCloud, Transform)[],
    d: EnemyDirector,
    s: EnemyAiSettings,
    physics: Physics,
    time: Time
) {
    if players.len() == 0 {
        return;
    }
    let player = players[0].1.position;
    let dt = time.dt;
    for (id, e, b, t, v) in enemies {
        let pos = t.position;
        let half = half_height(t);
        b.grounded = physics.raycast_mask(pos, vec2(0.0, 1.0), half + 14.0, WALL_BITS).hit && v.linear.y > -50.0;
        let now = b.mode.now;
        let entered = b.entered;
        b.entered = false;

        let speed = e.speed;
        if e.slow_time > 0.0 {
            e.slow_time -= dt;
            speed = e.speed * 0.35;
        }
        let goal = pos.x;
        let run = speed;

        if now == Mode::Patrol {
            if entered {
                b.goal_x = b.home_x + b.facing * s.patrol_span;
            }
            if b.pause > 0.0 {
                b.pause -= dt;
            } else if (b.goal_x - pos.x).abs() < ARRIVE || b.blocked {
                b.pause = d.rng.range_float(0.6, 1.4);
                b.facing = -b.facing;
                b.goal_x = b.home_x + b.facing * s.patrol_span * d.rng.range_float(0.5, 1.0);
                b.blocked = false;
            } else {
                goal = b.goal_x;
                run = speed * 0.45;
            }
        } else if now == Mode::Notice {
            if entered && b.grounded {
                v.linear = vec2(0.0, -520.0);
            }
        } else if now == Mode::Chase {
            if e.sides == 6 {
                let ring = e.melee_range * 0.6;
                if d.attackers >= max_attackers(s) {
                    ring = e.melee_range + WAIT_RING;
                }
                goal = player.x + b.side * ring;
                let across = (pos.x - player.x).abs();
                if sign(pos.x - player.x) != b.side && across < 320.0 && b.grounded && b.jump_cd <= 0.0 {
                    v.linear = vec2(b.side * clamp(2.4 * across, 350.0, 750.0), -jump_speed(260.0));
                    b.jump_cd = 1.0;
                    if s.log_states {
                        log("[ai] " + kind_name(e) + "#" + string(id.id) + " flanks");
                    }
                }
            } else {
                let dx = pos.x - player.x;
                let away = if dx < 0.0 { -1.0 } else { 1.0 };
                let dist = (dx).abs();
                if dist < s.ranged_min {
                    goal = player.x + away * s.ranged_min;
                } else if dist > s.ranged_max || !b.sees {
                    goal = player.x + away * (s.ranged_min + s.ranged_max) * 0.5;
                    if !b.sees {
                        goal = b.last_seen.x;
                    }
                }
            }
        } else if now == Mode::Windup {
            v.linear = vec2(v.linear.x * 0.8, v.linear.y);
            b.facing = sign(b.aim.x - pos.x);
        } else if now == Mode::Strike {
            if entered {
                b.struck = false;
                b.landed = false;
                if e.sides == 6 {
                    let dx = b.aim.x - pos.x;
                    v.linear = vec2(sign(dx) * min(e.lunge_speed, dx.abs() * 2.2 + 250.0), -640.0);
                }
            }
        } else if now == Mode::Recover {
            if e.sides == 6 && b.grounded {
                goal = pos.x + sign(pos.x - player.x) * 80.0;
                run = speed * 0.5;
            }
        } else if now == Mode::Retreat && (player.x - pos.x).abs() < SAFE_DISTANCE {
            let away = sign(pos.x - player.x);
            goal = pos.x + away * 300.0;
            for i in range(d.xs.len()) {
                let ax = d.xs[i];
                if sign(ax - pos.x) == away && (ax - pos.x).abs() > 60.0 && (ax - pos.x).abs() < 900.0 {
                    goal = ax + away * 90.0;
                }
            }
            run = speed * 1.15;
        } else if now == Mode::Search {
            if (b.last_seen.x - pos.x).abs() > ARRIVE * 2.0 && !b.blocked {
                goal = b.last_seen.x;
                run = speed * 0.7;
            } else if int(b.mode.time / 0.7) % 2 == 0 {
                b.facing = 1.0;
            } else {
                b.facing = -1.0;
            }
        }

        if now != Mode::Windup && now != Mode::Strike {
            for (c, ct) in clouds {
                if c.landed && c.life > 0.0 && (pos.x - ct.position.x).abs() < c.radius + 30.0 {
                    let out = if pos.x < ct.position.x { -1.0 } else { 1.0 };
                    goal = ct.position.x + out * (c.radius + 90.0);
                    run = speed * 1.2;
                }
            }
        }

        let moving = now != Mode::Windup && now != Mode::Strike && now != Mode::Notice;
        if moving {
            let dx = goal - pos.x;
            let vx = 0.0;
            if dx.abs() > ARRIVE {
                let dir = sign(dx);
                vx = dir * run;
                b.facing = dir;
                for i in range(d.xs.len()) {
                    let gap = d.xs[i] - pos.x;
                    if sign(gap) == dir && gap.abs() > 1.0 && gap.abs() < 95.0 && (d.ys[i] - pos.y).abs() < 60.0 {
                        vx = vx * 0.25;
                    }
                }
                if b.grounded && b.jump_cd <= 0.0 {
                    b.blocked = false;
                    let step_y = pos.y + half * 0.4;
                    let wall = physics.raycast_mask(vec2(pos.x, step_y), vec2(dir, 0.0), half + 45.0, WALL_BITS);
                    if wall.hit {
                        let over = wall.point.x + dir * 14.0;
                        let top = physics.raycast_mask(vec2(over, pos.y - MAX_JUMP - half), vec2(0.0, 1.0), MAX_JUMP + half * 2.0, WALL_BITS);
                        let rise = pos.y + half - top.point.y;
                        let headroom = !physics.raycast_mask(pos, vec2(0.0, -1.0), rise + 20.0, WALL_BITS).hit;
                        if top.hit && top.fraction > 0.01 && rise <= MAX_JUMP && headroom {
                            v.linear = vec2(vx, -jump_speed(rise + 40.0));
                            b.jump_cd = 0.4;
                        } else {
                            b.blocked = true;
                            vx = 0.0;
                        }
                    }
                }
            } else if now != Mode::Patrol && now != Mode::Search {
                b.facing = sign(player.x - pos.x);
            }
            if e.sides == 6 && now == Mode::Chase && b.grounded && (player.x - pos.x).abs() < 200.0 && player.y < pos.y - 140.0 {
                v.linear = vec2(sign(player.x - pos.x) * run, -jump_speed(pos.y - player.y + 60.0));
            }
            if b.grounded || vx != 0.0 {
                v.linear = vec2(vx, v.linear.y);
            }
        }

        if e.sides == 6 && b.grounded && b.dodge_cd <= 0.0 && now != Mode::Strike && now != Mode::Patrol {
            for (shot, st) in shots {
                let rel = pos - st.position;
                let speed2 = shot.vel.dot(shot.vel);
                if speed2 > 1.0 {
                    let eta = rel.dot(shot.vel) / speed2;
                    let miss = (rel - shot.vel * eta).length();
                    if eta > 0.05 && eta < 0.4 && miss < 110.0 && b.dodge_cd <= 0.0 {
                        b.dodge_cd = 0.9;
                        let dodges = d.rng.chance(clamp(s.dodge * s.difficulty, 0.0, 0.95));
                        if dodges {
                            v.linear = vec2(sign(rel.x) * speed, -jump_speed(240.0));
                        }
                        if s.log_states {
                            log("[ai] " + kind_name(e) + "#" + string(id.id) + " sees a spell coming: " + if dodges { "hops over it" } else { "too slow" });
                        }
                    }
                }
            }
        }
    }
}

fn jump_speed(height: float) -> float {
    return (2.0 * GRAVITY * max(height, 0.0)).sqrt();
}

@system(in_state: [GameState::Playing], after: [enemy_steer])
fn enemy_strikes(enemies: (Enemy, Brain, Transform)[], players: (Player, Transform, Velocity, Entity)[], cmd: Commands, state: State<GameState>) {
    for (e, b, t) in enemies {
        if b.mode.now != Mode::Strike {
            continue;
        }
        for (p, pt, pv, pe) in players {
            if e.sides == 6 {
                if !b.struck && t.position.distance(pt.position) <= MELEE_HIT {
                    b.struck = true;
                    b.landed = true;
                    hurt_player(cmd, p, pe, pt, pv, state, t.position);
                }
            } else if !b.struck {
                b.struck = true;
                let dir = b.aim - t.position;
                if dir.length() < 1.0 {
                    dir = vec2(b.facing, 0.0);
                }
                spawn_bolt(cmd, t.position, dir.normalized(), e.shot_speed);
            }
        }
    }
}

@system(in_state: [GameState::Playing], after: [enemy_faces])
fn enemy_telegraphs(enemies: (Enemy, Brain, Transform, Sprite)[], s: EnemyAiSettings, draw: Draw) {
    let pace = tempo(s);
    draw.overlay();
    for (e, b, t, sprite) in enemies {
        let pos = t.position;
        let head = pos - vec2(0.0, half_height(t) + 46.0);
        let now = b.mode.now;
        if now == Mode::Notice {
            draw.text("!", head - vec2(8.0, 0.0), 48.0, Color { r: 1.0, g: 0.85, b: 0.2, a: 1.0 });
        } else if now == Mode::Search {
            draw.text("?", head - vec2(8.0, 0.0), 40.0, Color { r: 0.7, g: 0.8, b: 1.0, a: 0.8 });
        } else if now == Mode::Windup {
            let length = s.ranged_aim / pace;
            if e.sides == 6 {
                length = s.melee_windup / pace;
            }
            let k = clamp(b.mode.time / max(length, 0.01), 0.0, 1.0);
            if e.sides == 6 {
                draw.circle_lines(pos, half_height(t) * (2.4 - 1.2 * k), Color { r: 1.0, g: 0.25, b: 0.15, a: 0.5 + 0.5 * k }, 5.0);
                let dir = sign(b.aim.x - pos.x);
                let tip = pos + vec2(dir * (half_height(t) + 40.0 + 30.0 * k), 0.0);
                draw.triangle(tip, tip - vec2(dir * 30.0, 18.0), tip - vec2(dir * 30.0, -18.0), Color { r: 1.0, g: 0.3, b: 0.2, a: 0.4 + 0.6 * k });
            } else {
                let locked = b.mode.time >= (s.ranged_aim - s.ranged_lock) / pace;
                let width = if locked { 4.0 } else { 2.0 };
                draw.line(pos, b.aim, Color { r: 0.6, g: 0.85, b: 1.0, a: 0.25 + 0.6 * k }, width);
                draw.circle_lines(b.aim, 26.0 - 12.0 * k, Color { r: 0.6, g: 0.85, b: 1.0, a: 0.4 + 0.6 * k }, 3.0);
            }
            if e.hurt_time <= 0.0 && int(b.mode.time * 10.0) % 2 == 0 {
                sprite.color = Color { r: 1.0, g: 0.55, b: 0.45, a: 1.0 };
            }
        }
        if s.show_states {
            draw.text(mode_name(now) + " " + string(e.health), head - vec2(40.0, 40.0), 22.0, Color { r: 1.0, g: 1.0, b: 1.0, a: 0.9 });
        }
    }
}
