import "drift" { * };
import "game_state.cdl" { * };
import "torches.cdl" { * };
import "enemy.cdl" { * };

@settings(section: "dungeon")
struct DungeonSettings {
    tiles: string[] = ["assets/creamTile.png", "assets/brownTile.png"],
    mortar: int = 1,
    stagger: bool = true,
    scale: float = 2.0,
    wall: float = 32.0,
    ceiling: float = 28.0,
    floor_height: float = 20.0,
    mortar_color: Color = Color { r: 0.12, g: 0.12, b: 0.13, a: 1.0 },
    wall_shade: float = 0.55,
    crack_color: Color = Color { r: 0.05, g: 0.045, b: 0.04, a: 0.9 },
    crack_edge: Color = Color { r: 1.0, g: 1.0, b: 1.0, a: 0.12 },
    crack_density: float = 0.8,
    crack_min: float = 40.0,
    crack_max: float = 140.0,
    crack_step: float = 3.0,
    crack_jitter: float = 0.35,
    crack_branch: float = 0.3,
    pebble_color: Color = Color { r: 0.42, g: 0.39, b: 0.36, a: 1.0 },
    pebble_spacing: float = 3.0,
    pebble_min: float = 1.2,
    pebble_max: float = 3.6,
    cracks: bool = false,
    wall_variants: int = 3,
    ground_tile: int = 256,
    torches_per_chunk: int = 2,
    torch_height: float = 0.45,
    chunks_behind: int = 1,
    chunks_ahead: int = 2,
    seed: int = 1234,

    max_crates: int = 5,
    max_stack: int = 2,
    crate_stack_chance: float = 0.5,
    crate_chance: float = 0.6,
    crate_scale: float = 1.5,

    max_enemies: int = 2,
    enemy_chance: float = 0.5,
    d4_chance: float = 0.4,
    safe_chunks: int = 1,
    enemy_ramp: int = 3,
    enemy_chance_step: float = 0.04,
}

@resource
struct CrateAssets {
    square: Texture = texture("assets/squareCrate.png"),
    wide: Texture = texture("assets/recCrate.png"),
}

@component struct Crate {}

@component
struct Chunk { index: int = 0 }

@resource
struct DungeonState {
    ready: bool = false,
    w: int = 0,
    h: int = 0,
    chunk_w: int = 0,
    floor_top: float = 0.0,
    spawned: int[] = [],
    walls: Texture[] = [],
    ground: Texture = Texture { .. },
    ground_w: int = 0,
}

fn wall_shade(c: Color, k: float) -> Color {
    return Color { r: c.r * k, g: c.g * k, b: c.b * k, a: c.a };
}

fn brick_wall(assets: Assets, w: int, h: int, s: DungeonSettings, seed: int) -> Image {
    let bricks: Image[] = [];
    for path in s.tiles {
        bricks.push(assets.image(path));
    }
    let bw = bricks[0].width();
    let bh = bricks[0].height();
    let cw = bw + s.mortar;
    let ch = bh + s.mortar;
    let img = assets.create_image(w, h, s.mortar_color);
    let r = rng(seed);
    for row in range(h / ch + 1) {
        let shift = if s.stagger { (row % 2) * (cw / 2) } else { 0 };
        for col in range(w / cw + 2) {
            let pick = r.range(0, bricks.len() - 1);
            img.draw(bricks[pick], col * cw - shift, row * ch);
        }
    }
    return img;
}

fn crack(img: Image, r: Rng, start: Vec2, angle: float, length: float, s: DungeonSettings) {
    let p = start;
    let a = angle;
    let left = length;
    while left > 0.0 {
        a += r.range_float(-s.crack_jitter, s.crack_jitter);
        let step = r.range_float(s.crack_step * 0.5, s.crack_step * 1.5);
        let q = p + from_angle(a) * step;
        img.line(p + vec2(0.0, 1.0), q + vec2(0.0, 1.0), s.crack_edge, 1.0);
        img.line(p, q, s.crack_color, 1.0);
        if left > s.crack_min * 0.5 && r.chance(s.crack_branch * step / length) {
            crack(img, r, q, a + r.range_float(0.5, 1.1) * (if r.chance(0.5) { 1.0 } else { -1.0 }), left * r.range_float(0.3, 0.6), s);
        }
        p = q;
        left -= step;
    }
}

fn crack_overlay(assets: Assets, w: int, h: int, s: DungeonSettings, seed: int) -> Image {
    let img = assets.create_image(w, h, Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 });
    let r = rng(seed);
    let count = int(float(w * h) / 10000.0 * s.crack_density) + 1;
    for i in range(count) {
        let start = vec2(r.range_float(0.0, float(w)), r.range_float(0.0, float(h)));
        crack(img, r, start, r.range_float(0.0, TAU), r.range_float(s.crack_min, s.crack_max), s);
    }
    return img;
}

fn pebble_floor(assets: Assets, w: int, h: int, s: DungeonSettings, seed: int) -> Image {
    let r = rng(seed);
    let img = assets.create_image(w, h, wall_shade(s.pebble_color, 0.7));
    let count = int(float(w * h) / s.pebble_spacing);
    for i in range(count) {
        let p = vec2(r.range_float(-2.0, float(w) + 2.0), r.range_float(-2.0, float(h) + 2.0));
        let radius = r.range_float(s.pebble_min, s.pebble_max);
        let k = r.range_float(0.75, 1.25);
        let base = wall_shade(s.pebble_color, k);
        img.circle(p + vec2(0.4, 0.5), radius, wall_shade(base, 0.6));
        img.circle(p, radius, base);
        if radius > 1.2 {
            img.circle(p - vec2(radius * 0.35, radius * 0.35), radius * 0.35, wall_shade(base, 1.35));
        }
    }
    return img;
}

@component
struct DungeonBounds {}

fn spawn_bounds(cmd: Commands, st: DungeonState, s: DungeonSettings) {
    let k = s.scale;
    let left = -20000.0;
    let right = 400000.0;
    let w = right - left;
    let ground_h = (float(st.h) - st.floor_top) * k;
    cmd.spawn([
        at(left + w * 0.5, st.floor_top * k + ground_h * 0.5),
        RigidBody { kind: BodyKind::Static, .. },
        BoxCollider { half_size: vec2(w * 0.5, ground_h * 0.5), friction: 1.0, .. },
        DungeonBounds {},
    ]);
    let ceil_h = s.ceiling * k;
    cmd.spawn([
        at(left + w * 0.5, ceil_h * 0.5),
        RigidBody { kind: BodyKind::Static, .. },
        BoxCollider { half_size: vec2(w * 0.5, ceil_h * 0.5), friction: 0.3, .. },
        DungeonBounds {},
    ]);
}

fn block(cmd: Commands, index: int, x: float, y: float, w: float, h: float, scale: float) {
    if w <= 0.0 || h <= 0.0 {
        return;
    }
    cmd.spawn([
        at((x + w * 0.5) * scale, (y + h * 0.5) * scale),
        RigidBody { kind: BodyKind::Static, .. },
        BoxCollider { half_size: vec2(w * 0.5 * scale, h * 0.5 * scale), friction: 1.0, .. },
        Chunk { index: index },
    ]);
}

fn spawn_chunk(art: TorchAsset, cmd: Commands, st: DungeonState, s: DungeonSettings, ts: TorchSettings, crates: CrateAssets, foes: EnemyAssets, index: int) {
    let k = s.scale;
    let x0 = float(index * st.chunk_w);
    let width = float(st.chunk_w);
    let height = float(st.h);
    let shade = Color { r: s.wall_shade, g: s.wall_shade, b: s.wall_shade, a: 1.0 };
    let wall = ((index % st.walls.len()) + st.walls.len()) % st.walls.len();
    cmd.spawn([
        Transform { position: vec2((x0 + width * 0.5) * k, height * k * 0.5), scale: vec2(k, k), .. },
        Sprite { image: st.walls[wall], color: shade, z: -10.0, .. },
        Chunk { index: index },
    ]);

    let ground_h = height - st.floor_top;
    let tile_w = float(st.ground_w);
    for i in range(int(width / tile_w) + 1) {
        let gx = x0 + tile_w * (float(i) + 0.5);
        cmd.spawn([
            Transform { position: vec2(gx * k, (st.floor_top + ground_h * 0.5) * k), scale: vec2(k, k), .. },
            Sprite { image: st.ground, z: -5.0, .. },
            Chunk { index: index },
        ]);
    }

    block(cmd, index, x0, 0.0, width, s.ceiling, k);
    block(cmd, index, x0, st.floor_top, width, ground_h, k);

    let n = s.torches_per_chunk;
    let torch_y = (s.ceiling + (st.floor_top - s.ceiling) * s.torch_height) * k;
    for i in range(n) {
        let x = (x0 + width * (float(i) + 0.5) / float(n)) * k;
        let t = torch(cmd, vec2(x, torch_y), ts, art);
        cmd.insert(t, Chunk { index: index });
    }

    // Crates and enemies share one random sequence per chunk, so a chunk comes back the same.
    let r = rng(s.seed + index * 7349 + 17);
    let floor_y = st.floor_top * k;
    let left = x0 * k;
    let span = width * k;
    if index >= s.safe_chunks {
        spawn_crates(cmd, crates, s, r, index, left, span, floor_y);
        spawn_chunk_enemies(cmd, foes, s, r, index, left, span, floor_y);
    }
}

// Up to max_crates crates on the floor, some stacked on others.
fn spawn_crates(cmd: Commands, crates: CrateAssets, s: DungeonSettings, r: Rng, index: int, left: float, span: float, floor_y: float) {
    let ceiling_y = s.ceiling * s.scale;
    let xs: float[] = [];
    let half_ws: float[] = [];
    let tops: float[] = [];
    let levels: int[] = [];
    for i in range(s.max_crates) {
        if r.chance(s.crate_chance) {
            let img = crates.square;
            if r.chance(0.35) {
                img = crates.wide;
            }
            let size = img.size();
            let hw = size.x * s.crate_scale * 0.5;
            let hh = size.y * s.crate_scale * 0.5;
            let x = left + span * r.range_float(0.1, 0.9);
            if xs.len() > 0 && r.chance(s.crate_stack_chance) {
                let j = r.range(0, xs.len() - 1);
                x = xs[j] + half_ws[j] * r.range_float(-0.4, 0.4);
            }
            let base = floor_y;
            let level = 1;
            for j in range(xs.len()) {
                if (x - xs[j]).abs() < hw + half_ws[j] && tops[j] < base {
                    base = tops[j];
                    level = levels[j] + 1;
                }
            }
            let y = base - hh - 1.0;
            if level <= s.max_stack && y - hh > ceiling_y + 20.0 {
                xs.push(x);
                half_ws.push(hw);
                tops.push(y - hh);
                levels.push(level);
                cmd.spawn([
                    Transform { position: vec2(x, y), scale: vec2(s.crate_scale, s.crate_scale), .. },
                    Sprite { image: img, z: 50.0, .. },
                    RigidBody { kind: BodyKind::Static, .. },
                    Velocity { .. },
                    BoxCollider { half_size: vec2(hw, hh), friction: 1.0, .. },
                    Crate {},
                    Chunk { index: index },
                ]);
            }
        }
    }
}

fn start_dungeon(assets: Assets, window: Window, s: DungeonSettings, st: DungeonState) {
    let k = s.scale;
    let cw = assets.image(s.tiles[0]).width() + s.mortar;
    let w = int(window.width / k + 0.999);
    let h = int(window.height / k + 0.999);
    st.w = w;
    st.h = h;
    st.chunk_w = (w / cw + 1) * cw;
    st.floor_top = float(h) - s.wall - s.floor_height;
    let walls: Texture[] = [];
    for v in range(max_int(s.wall_variants, 1)) {
        let img = brick_wall(assets, st.chunk_w, h, s, s.seed + v * 7919);
        if s.cracks {
            img.draw(crack_overlay(assets, st.chunk_w, h, s, s.seed + v * 7919 + 1), 0, 0);
        }
        walls.push(img.to_texture());
    }
    st.walls = walls;
    st.ground_w = s.ground_tile;
    st.ground = pebble_floor(assets, s.ground_tile, int(float(h) - st.floor_top), s, s.seed + 2).to_texture();
    st.ready = true;
}

fn chunk_at(st: DungeonState, s: DungeonSettings, world_x: float) -> int {
    return int((world_x / (float(st.chunk_w) * s.scale)).floor());
}

@system
fn stream_dungeon(
    art: TorchAsset,
    cameras: (Camera, Transform)[],
    chunks: (Entity, Chunk)[],
    st: DungeonState,
    s: DungeonSettings,
    ts: TorchSettings,
    crates: CrateAssets,
    foes: EnemyAssets,
    cmd: Commands
) {
    if !st.ready {
        return;
    }
    for (_, t) in cameras {
        let here = chunk_at(st, s, t.position.x);
        let keep: int[] = [];
        for i in st.spawned {
            if i >= here - s.chunks_behind && i <= here + s.chunks_ahead {
                keep.push(i);
            }
        }
        for (e, c) in chunks {
            if !keep.contains(c.index) {
                cmd.despawn(e);
            }
        }
        for i in range(here - s.chunks_behind, here + s.chunks_ahead + 1) {
            if !keep.contains(i) {
                spawn_chunk(art, cmd, st, s, ts, crates, foes, i);
                keep.push(i);
            }
        }
        st.spawned = keep;
    }
}
