import "drift" { * };
import "game_state.cdl" { * };
import "player.cdl" { * };
import "enemy.cdl" { * };

@settings(section: "card")
struct CardSettings {
    scale: float = 4.0,
    spacing: float = 460.0,
    hand: int = 3,
    drop_chance: float = 0.08,
    card_at: int[] = [3, 5, 10],
    pickup_radius: float = 150.0,
    pickup_life: float = 20.0,
    rare_chance: float = 0.02,
    rare_after: int = 3,
    rare: string[] = ["health"],
}

@resource
struct CardAsset {
    bg: Texture = texture("assets/cards/cardBG.png"),
    middle: Texture = texture("assets/cards/cardTempMiddle.png"),
    names: string[] = ["speed", "chainbolt", "iceknife", "health", "gascloud", "fireball", "maxhealth", "maxmana"],
    abilities: Texture[] = [
        texture("assets/cards/speedCard.png"),
        texture("assets/cards/chainboltCard.png"),
        texture("assets/cards/iceknifeCard.png"),
        texture("assets/cards/healthCard.png"),
        texture("assets/cards/gascloudCard.png"),
        texture("assets/cards/fireballCard.png"),
        texture("assets/cards/healthCard.png"),
        texture("assets/cards/maxManaCard.png"),
    ],
}

@resource
struct Abilities {
    owned: string[] = [],
}

@resource
struct UpgradeProgress {
    rolls: int = 0,
}

@component
struct CardDrop {
    base_y: float = 0.0,
    age: float = 0.0,
}

@component
struct Card {
    ability: int = 0,
}

@component
struct CardPart {}

fn spawn_card(cmd: Commands, art: CardAsset, ability: int, pos: Vec2, scale: float) {
    cmd.spawn([
        Transform { position: pos, scale: vec2(scale, scale), .. },
        Sprite { image: art.middle, z: 1.0, layer: hud_layer(), .. },
        Card { ability: ability },
    ]);
    cmd.spawn([
        Transform { position: pos, scale: vec2(scale, scale), .. },
        Sprite { image: art.bg.to_image().crop(Rect { x: 24, y: 2, w: 55, h: 92 }).to_texture(), z: 0.5, layer: hud_layer(), .. },
        CardPart {},
    ]);
    cmd.spawn([
        Transform { position: pos, scale: vec2(scale, scale), .. },
        Sprite { image: art.abilities[ability], z: 2.0, layer: hud_layer(), .. },
        CardPart {},
    ]);
}

@system(on_exit: GameState::MainMenu)
fn reset_upgrades(progress: UpgradeProgress, owned: Abilities, kills: Kills) {
    kills.count = 0;
    kills.deaths = [];
    progress.rolls = 0;
    owned.owned = [];
}

const CARD_KILLS: int[] = [3, 8, 12, 16, 20, 24];

fn card_due(sets: CardSettings, kill: int) -> bool {
    return sets.card_at.contains(kill) || CARD_KILLS.contains(kill);
}

@system(in_state: [GameState::Playing])
fn card_drops(kills: Kills, sets: CardSettings, progress: UpgradeProgress, luck: Luck, art: CardAsset, cmd: Commands) {
    for pos in kills.deaths {
        progress.rolls += 1;
        if card_due(sets, progress.rolls) || luck.r.chance(sets.drop_chance) {
            cmd.spawn([
                Transform { position: pos, scale: vec2(1.2, 1.2), .. },
                Sprite { image: art.middle, z: 120.0, .. },
                CardDrop { base_y: pos.y, .. },
                ParticleEmitter {
                    rate: 25.0, lifetime_min: 0.5, lifetime_max: 1.2,
                    speed_min: 10.0, speed_max: 45.0, angle_min: -2.6, angle_max: -0.54,
                    size_start: 5.0, size_end: 0.5,
                    color_start: Color { r: 1.0, g: 0.9, b: 0.5, a: 1.0 },
                    color_end: Color { r: 1.0, g: 0.6, b: 0.2, a: 0.0 },
                    shape: EmitShape::Circle, shape_radius: 40.0,
                    blend: Blend::Additive, max_particles: 60, z: 121.0, ..
                },
            ]);
        }
    }
    kills.deaths = [];
}

@system(in_state: [GameState::Playing])
fn card_pickups(drops: (Entity, CardDrop, Transform)[], player: (Player, Transform)[], sets: CardSettings, time: Time, state: State<GameState>, cmd: Commands) {
    for (e, d, t) in drops {
        d.age += time.dt;
        t.position = vec2(t.position.x, d.base_y - 30.0 - 12.0 * sin(d.age * 3.0));
        let taken = false;
        for (_, pt) in player {
            if t.position.distance(pt.position) <= sets.pickup_radius {
                taken = true;
            }
        }
        if taken {
            cmd.despawn(e);
            state.set(GameState::PickingUpgrade);
        } else if d.age >= sets.pickup_life {
            cmd.despawn(e);
        }
    }
}

@system(on_exit: GameState::MainMenu)
fn clear_card_drops(drops: (Entity, CardDrop)[], cmd: Commands) {
    for (e, _) in drops {
        cmd.despawn(e);
    }
}

@system(on_enter: GameState::PickingUpgrade)
fn deal_cards(art: CardAsset, sets: CardSettings, owned: Abilities, window: Window, luck: Luck, cmd: Commands) {
    let r = rng(luck.r.range(1, 1000000000));
    let common: int[] = [];
    let rare: int[] = [];
    for i in range(art.abilities.len()) {
        if sets.rare.contains(art.names[i]) {
            rare.push(i);
        } else {
            common.push(i);
        }
    }
    let n = min_int(sets.hand, common.len() + rare.len());
    let left = window.width * 0.5 - sets.spacing * float(n - 1) * 0.5;
    for i in range(n) {
        let rare_ok = owned.owned.len() >= sets.rare_after;
        let use_rare = rare.len() > 0 && rare_ok && (common.len() == 0 || r.chance(sets.rare_chance));
        let ability = 0;
        if use_rare {
            let j = r.range(0, rare.len() - 1);
            ability = rare[j];
            rare.remove(j);
        } else {
            let j = r.range(0, common.len() - 1);
            ability = common[j];
            common.remove(j);
        }
        spawn_card(cmd, art, ability, vec2(left + sets.spacing * float(i), window.height * 0.5), sets.scale);
    }
}

@system(in_state: [GameState::PickingUpgrade])
fn pick_card(cards: (Card, Sprite, Transform)[], art: CardAsset, owned: Abilities, input: Input, state: State<GameState>) {
    let m = input.mouse_screen();
    for (c, sprite, t) in cards {
        if mouse_over(m, art.middle.size(), t) {
            sprite.color = Color { r: 1.0, g: 0.9, b: 0.55, a: 1.0 };
            if input.mouse_pressed(MouseButton::Left) {
                owned.owned.push(art.names[c.ability]);
                log("picked " + art.names[c.ability]);
                state.set(GameState::Playing);
            }
        } else {
            sprite.color = Color { .. };
        }
    }
}

@system(on_exit: GameState::PickingUpgrade)
fn clear_cards(cards: (Entity, Card)[], parts: (Entity, CardPart)[], cmd: Commands) {
    for (e, _) in cards {
        cmd.despawn(e);
    }
    for (e, _) in parts {
        cmd.despawn(e);
    }
}
